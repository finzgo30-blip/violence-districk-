-- ===== CAMERA: Custom FOV + Unlimited Zoom =====
do
    pcall(function() RunService:UnbindFromRenderStep("ZirthCamera") end)
    if type(Z.ZirthCameraRestore) == "function" then pcall(Z.ZirthCameraRestore) end

    local CAM = { FovOn = false, Fov = 70, ZoomOn = false }
    State.CameraFX = CAM
    local origFov, origMax, origMin, origMode
    local zoomConns = {}
    local zoomD = nil          -- our own camera distance (only used when it is bigger than the game's)
    local lastPinch = 1
    local ZOOM_MAX, ZOOM_MIN, ZOOM_STEP = 5000, 0.5, 1.15

    local function applyZoomLimits()
        pcall(function()
            if LP.CameraMaxZoomDistance < 1e5 then LP.CameraMaxZoomDistance = 1e5 end
            if LP.CameraMinZoomDistance > ZOOM_MIN then LP.CameraMinZoomDistance = ZOOM_MIN end
            if LP.CameraMode == Enum.CameraMode.LockFirstPerson then
                LP.CameraMode = Enum.CameraMode.Classic
            end
        end)
    end

    local function focusPosition(cam)
        local f = cam.Focus.Position
        if (f - cam.CFrame.Position).Magnitude > 4000 then
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then return hrp.Position + Vector3.new(0, 1.5, 0) end
        end
        return f
    end

    -- Works even when the game's own camera script clamps zoom: the wheel / pinch moves the camera
    -- further back along its view direction once the game's own zoom has stopped.
    local function zoomOut(factor)
        local cam = workspace.CurrentCamera
        if not cam then return end
        local base = (cam.CFrame.Position - focusPosition(cam)).Magnitude
        if zoomD == nil or zoomD < base then zoomD = base end
        zoomD = math.clamp(zoomD * factor, ZOOM_MIN, ZOOM_MAX)
    end

    local function connectZoomInput()
        if #zoomConns > 0 then return end
        zoomConns[#zoomConns + 1] = UserInputService.InputChanged:Connect(function(input, processed)
            if processed or unloaded or not CAM.ZoomOn then return end
            if input.UserInputType == Enum.UserInputType.MouseWheel then
                if input.Position.Z > 0 then zoomOut(1 / ZOOM_STEP) else zoomOut(ZOOM_STEP) end
            end
        end)
        zoomConns[#zoomConns + 1] = UserInputService.TouchPinch:Connect(function(_, scale, _, state, processed)
            if processed or unloaded or not CAM.ZoomOn then return end
            if state == Enum.UserInputState.Begin then
                lastPinch = 1
            elseif state == Enum.UserInputState.Change and scale > 0 and lastPinch > 0 then
                local ratio = scale / lastPinch
                lastPinch = scale
                zoomOut(1 / ratio)
            end
        end)
    end
    local function disconnectZoomInput()
        for _, c in ipairs(zoomConns) do pcall(function() c:Disconnect() end) end
        zoomConns = {}
        zoomD = nil
    end

    -- runs right after the game's own camera scripts, every frame, so the game cannot overwrite it
    local function step()
        if unloaded then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        if CAM.FovOn then
            local want = math.clamp(tonumber(CAM.Fov) or 70, 1, 120)
            if math.abs(cam.FieldOfView - want) > 0.01 then cam.FieldOfView = want end
        end
        if CAM.ZoomOn then
            applyZoomLimits()
            if zoomD then
                local focus = focusPosition(cam)
                local base = (cam.CFrame.Position - focus).Magnitude
                if zoomD <= base + 0.05 then
                    zoomD = nil                      -- the game's own zoom is already at least this far: hands off
                else
                    local look = cam.CFrame.LookVector
                    cam.CFrame = CFrame.new(focus - look * zoomD) * cam.CFrame.Rotation
                end
            end
        end
    end

    local bound = false
    local function updateBinding()
        local need = CAM.FovOn or CAM.ZoomOn
        if need and not bound then
            bound = true
            RunService:BindToRenderStep("ZirthCamera", Enum.RenderPriority.Camera.Value + 1, step)
        elseif not need and bound then
            bound = false
            pcall(function() RunService:UnbindFromRenderStep("ZirthCamera") end)
        end
    end

    local function setFov(state)
        state = state == true
        if CAM.FovOn == state then return end
        local cam = workspace.CurrentCamera
        if state then
            origFov = cam and cam.FieldOfView or 70
        elseif cam and origFov then
            cam.FieldOfView = origFov
        end
        CAM.FovOn = state
        updateBinding()
    end

    local function setZoom(state)
        state = state == true
        if CAM.ZoomOn == state then return end
        if state then
            origMax, origMin, origMode = LP.CameraMaxZoomDistance, LP.CameraMinZoomDistance, LP.CameraMode
            applyZoomLimits()
            connectZoomInput()
            -- undo the game putting its own limits back, the moment it happens
            for _, prop in ipairs({ "CameraMaxZoomDistance", "CameraMinZoomDistance", "CameraMode" }) do
                zoomConns[#zoomConns + 1] = LP:GetPropertyChangedSignal(prop):Connect(function()
                    if CAM.ZoomOn then applyZoomLimits() end
                end)
            end
        else
            disconnectZoomInput()
            pcall(function()
                if origMax then LP.CameraMaxZoomDistance = origMax end
                if origMin then LP.CameraMinZoomDistance = origMin end
                if origMode then LP.CameraMode = origMode end
            end)
        end
        CAM.ZoomOn = state
        updateBinding()
    end

    Z.ZirthCameraRestore = function()
        setFov(false)
        setZoom(false)
    end

    local CameraSection = State.WorldSettingsSection
    CreateToggle(CameraSection, "Custom FOV", false, function(state) setFov(state) end)
    CreateSlider(CameraSection, "FOV", 30, 120, 70, "", function(value)
        CAM.Fov = value
    end)
    CreateToggle(CameraSection, "Unlimited Zoom", false, function(state) setZoom(state) end)
end

