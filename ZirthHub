State.SkillCheckTrap = { On = false, Mode = "Legit" }
do
	local T = State.SkillCheckTrap
	local conn
	local busy = false
	local lastPrompt, promptStart = nil, 0

	local function setShared(v)
		local o = State.SkillCheckObj
		if o then o._busy = v end
	end

	local function trapFire()
		local o = State.SkillCheckObj
		if o then o:_fireAction(0.02) end
	end

	local function pingSec()
		local p = 0.06
		pcall(function() p = LP:GetNetworkPing() end)
		if type(p) ~= "number" or p ~= p or p <= 0 then p = 0.06 end
		return p
	end

	local function findCheck(pg)
		for _, name in ipairs({ "SkillCheckPromptGui", "SkillCheckPromptGui-con" }) do
			local prompt = pg:FindFirstChild(name)
			if prompt and prompt.Enabled ~= false then
				local c = prompt:FindFirstChild("Check") or prompt:FindFirstChild("check")
				if c and c.Visible then return c end
			end
		end
		for _, gui in ipairs(pg:GetChildren()) do
			if gui:IsA("ScreenGui") and gui.Enabled ~= false then
				local c = gui:FindFirstChild("Check") or gui:FindFirstChild("check")
				if c and c.Visible and (c:FindFirstChild("Line") or c:FindFirstChild("line")) then return c end
			end
		end
		return nil
	end

	local function step()
		if unloaded or busy then return end
		local genOn = State.SkillCheck and State.SkillCheck.Enabled == true
		if not (T.On or genOn) then return end
		local pg = LP:FindFirstChildOfClass("PlayerGui")
		if not pg then return end
		local check = findCheck(pg)
		if not check then
			lastPrompt = nil
			State.TrapSpoofLine, State.TrapSpoofRot = nil, nil
			return
		end
		local line = check:FindFirstChild("Line") or check:FindFirstChild("line")
		if not line then return end

		local trapGoal = check:FindFirstChild("TrapGoal") or check:FindFirstChild("trapGoal")
		local trapPerfect = check:FindFirstChild("TrapPerfect") or check:FindFirstChild("trapPerfect")
		local char = LP.Character
		local trapped = char and (char:GetAttribute("Trapped") == true or char:GetAttribute("EscapingTrap") == true)
		local isTrap = (trapGoal and trapGoal.Visible) or (trapPerfect and trapPerfect.Visible) or trapped
		if not isTrap then
			lastPrompt = nil
			return
		end

		if check ~= lastPrompt then
			lastPrompt = check
			promptStart = os.clock()
		end

		local targetRot, zoneStart, zoneEnd
		if trapGoal and trapGoal.Visible then
			targetRot = (trapGoal.Rotation + 109) % 360
			zoneStart = (trapGoal.Rotation + 104) % 360
			zoneEnd = (trapGoal.Rotation + 115) % 360
		elseif trapPerfect and trapPerfect.Visible then
			targetRot = trapPerfect.Rotation % 360
			zoneStart = (trapPerfect.Rotation - 5) % 360
			zoneEnd = (trapPerfect.Rotation + 15) % 360
		else
			local goal = check:FindFirstChild("Goal") or check:FindFirstChild("goal")
			local gr = goal and goal.Rotation or 0
			targetRot = (gr + 109) % 360
			zoneStart = (gr + 104) % 360
			zoneEnd = (gr + 115) % 360
		end

		local mode = T.On and T.Mode or (State.SkillCheck and State.SkillCheck.Mode) or "Instant"
		local ping = pingSec()
		if mode == "Instant" then
			local minWait = math.clamp(0.08 + ping * 0.4, 0.10, 0.18)
			if os.clock() - promptStart < minWait then return end
			busy = true
			setShared(true)
			if State.InstallRotationHook then pcall(State.InstallRotationHook) end
			State.TrapSpoofLine, State.TrapSpoofRot = line, targetRot
			line.Rotation = targetRot
			task.spawn(function()
				local lockActive = true
				local lockConn = RunService.RenderStepped:Connect(function()
					if lockActive and line and line.Parent then line.Rotation = targetRot end
				end)
				for _ = 1, 2 do
					line.Rotation = targetRot
					RunService.Heartbeat:Wait()
				end
				pcall(trapFire)
				task.wait(0.10)
				lockActive = false
				if lockConn then lockConn:Disconnect() end
				task.wait(0.15)
				State.TrapSpoofLine, State.TrapSpoofRot = nil, nil
				busy = false
				setShared(false)
			end)
		else
			local lead = math.clamp(ping * 100, 4, 16)
			local lr = line.Rotation % 360
			local sR = (zoneStart - lead) % 360
			local inZone
			if sR > zoneEnd then inZone = lr >= sR or lr <= zoneEnd else inZone = lr >= sR and lr <= zoneEnd end
			if inZone then
				busy = true
				setShared(true)
				task.spawn(function()
					pcall(trapFire)
					task.wait(0.2)
					busy = false
					setShared(false)
				end)
			end
		end
	end

	conn = RunService.RenderStepped:Connect(function() pcall(step) end)

	State.TrapSkillSet = function(v)
		T.On = v == true
		if not T.On then
			State.TrapSpoofLine, State.TrapSpoofRot = nil, nil
		end
	end

	State.TrapSkillDestroy = function()
		T.On = false
		if conn then conn:Disconnect(); conn = nil end
		State.TrapSpoofLine, State.TrapSpoofRot = nil, nil
		busy = false
		setShared(false)
	end
end


