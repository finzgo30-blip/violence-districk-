    SlidePadding.Parent = Slide
    SlidePadding.PaddingTop = UDim.new(0, 8)
    SlidePadding.PaddingLeft = UDim.new(0, 10)
    SlidePadding.PaddingRight = UDim.new(0, 10)
    SlidePadding.PaddingBottom = UDim.new(0, 8)

    SlideLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Slide.CanvasSize = UDim2.new(0, 0, 0, SlideLayout.AbsoluteContentSize.Y + 16)
        if currentActiveSlide == Slide then
            task.defer(updateFades)
        end
    end)

    Slide:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
        if currentActiveSlide == Slide then
            updateFades()
        end
    end)

    Slide:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        if currentActiveSlide == Slide then
            updateFades()
        end
    end)

    local tabData = {
        Button = TabBtn, Slide = Slide, IconBox = IconBox,
        SetIcon = SetIcon, TabLbl = TabLbl
    }
    Tabs[tabName] = tabData

    local function selectThis()
        if activeTab == tabName then return end
        for _, t in pairs(Tabs) do
            t.Slide.Visible = false
            setTabVisual(t, false)
        end
        Slide.Visible = true
        setTabVisual(tabData, true)
        activeTab = tabName
        currentActiveSlide = Slide
        task.defer(updateFades)
    end

    tabData.Select = selectThis
    tabData.Name = tabName
    TabBtn.MouseButton1Click:Connect(selectThis)

    if isDefault then
        Slide.Visible = true
        setTabVisual(tabData, true)
        activeTab = tabName
        currentActiveSlide = Slide
    end

    return Slide
end

