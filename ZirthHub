    local function blinkOutline(stroke)
        if not stroke then return end
        local origColor = stroke.Color
        local origTrans = stroke.Transparency
        local origThick = stroke.Thickness
        task.spawn(function()
            for _ = 1, 3 do
                if not stroke.Parent then return end
                TweenService:Create(stroke, TweenInfo.new(0.14), {
                    Color = C.Active, Transparency = 0, Thickness = 2
                }):Play()
