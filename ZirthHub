local function KINON_FakeHitBlocked(animTrack, killerRoot, playerRoot, vel)
	if not Z.AntiFakeHit or not animTrack then return false end
	local ok, blocked = pcall(function()
		local tp, spd = 0, 1
		pcall(function()
			tp = animTrack.TimePosition or 0
			spd = animTrack.Speed or 1
		end)
		if spd <= 0.05 then return true end

		local lead = 0.18
		pcall(function() lead = math.clamp(LP:GetNetworkPing() + 0.09, 0.12, 0.35) end)
		local kVel = (typeof(vel) == "Vector3") and vel or (killerRoot.AssemblyLinearVelocity or Vector3.zero)
		local myVel = playerRoot.AssemblyLinearVelocity or Vector3.zero
		local predictedKillerPos = killerRoot.Position + kVel * lead
		local predictedMyPos = playerRoot.Position + myVel * lead
		local rawDist = (killerRoot.Position - playerRoot.Position).Magnitude
		local dist = (predictedKillerPos - predictedMyPos).Magnitude
		local baseRange = math.clamp(tonumber(Parry.Range) or 14, 5, 35)
			+ math.clamp(tonumber(Parry.ReachBonus) or 0, 0, 10)

		local relVelTowardMe = 0
		local dirToMe = (predictedMyPos - predictedKillerPos)
		if dirToMe.Magnitude > 0.05 then
			relVelTowardMe = kVel:Dot(dirToMe.Unit)
		end

		if math.min(dist, rawDist) > (baseRange * 0.82)
			and relVelTowardMe < 2.0 and tp < 0.04 then
			return true
		end
		return false
	end)
	return ok and blocked == true
end

local function KINON_HandleAttackTrack(animTrack, model)
	if not (Parry.Enabled or ParryV2.Enabled) or not animTrack or not model or not model.Parent then return end
	local animationId = KINON_AnimationId(animTrack)
	if animationId == "" or KINON_IgnoredParryAnimationIds[animationId] then return end
	if VD_NO_PARRY_ANIMS[animationId] then return end

	local modelName = string.lower(tostring(model.Name or ""))
	if modelName:find("veil", 1, true) then
		local trackName = ""
		pcall(function() trackName = string.lower(tostring(animTrack.Name or "")) end)
		local animationName = ""
		pcall(function() animationName = string.lower(tostring(animTrack.Animation and animTrack.Animation.Name or "")) end)
		local label = trackName .. " " .. animationName
		if label:find("spear", 1, true) or label:find("throw", 1, true)
			or label:find("charge", 1, true) then return end
	end

	local optionalAttack = VD_OPTIONAL_ATTACK_ANIMS[animationId]
	if optionalAttack and VD_SkipParryOptions[animationId] == true then return end
	local knownAttack = KINON_KillerAttackIds[animationId] == true
		or (optionalAttack ~= nil and optionalAttack.Default == true)
	if not knownAttack then return end

	local function timeLimit(killerRootX)
		return 0.45
	end
	local okTime, timePosition = pcall(function() return animTrack.TimePosition or 0 end)
	if okTime and timePosition > timeLimit(model:FindFirstChild("HumanoidRootPart")) then return end

	do
		local playerRoot0 = getRoot()
		local killerRoot0 = model:FindFirstChild("HumanoidRootPart")
		if playerRoot0 and killerRoot0 then
			local pass0 = KINON_ParryInRange(killerRoot0, playerRoot0, killerRoot0.AssemblyLinearVelocity, KINON_LungeAnimationIds[animationId] == true, optionalAttack ~= nil)
			if pass0 and not KINON_FakeHitBlocked(animTrack, killerRoot0, playerRoot0, killerRoot0.AssemblyLinearVelocity)
				and KINON_TryParry("Instant " .. animationId, killerRoot0, true) then return end
		end
	end

	task.spawn(function()
		local startTime = tick()
		local lastPos, lastT, vel
		local firstPass = true
		repeat
			if unloaded or not (Parry.Enabled or ParryV2.Enabled) or not animTrack.IsPlaying then break end
			local currentTime = 0
			pcall(function() currentTime = animTrack.TimePosition or 0 end)
			local playerRoot = getRoot()
			local killerRoot = model:FindFirstChild("HumanoidRootPart")
			if currentTime > timeLimit(killerRoot) then break end
			if killerRoot then
				local nowT = tick()
				local pos = killerRoot.Position
				if lastPos and nowT > lastT then
					local v = (pos - lastPos) / (nowT - lastT)
					vel = vel and (vel * 0.5 + v * 0.5) or v
				end
				lastPos, lastT = pos, nowT
			end
			if playerRoot and killerRoot and KINON_ParryEngine.Gate() then
				local pass = KINON_ParryInRange(killerRoot, playerRoot, vel, KINON_LungeAnimationIds[animationId] == true, optionalAttack ~= nil)
				if pass and not KINON_FakeHitBlocked(animTrack, killerRoot, playerRoot, vel) then
					local wasFirst = firstPass
					firstPass = false
					if KINON_TryParry("Animation " .. animationId, killerRoot, wasFirst) then return end
				end
			end
			RunService.PreSimulation:Wait()
		until tick() - startTime >= 0.45
	end)
end

local function KINON_HookAnimator(animator, model)
	if not animator or KINON_ParryEngine.SeenAnimators[animator] then return end
	KINON_ParryEngine.SeenAnimators[animator] = true
	local ok, connection = pcall(function()
		return animator.AnimationPlayed:Connect(function(animTrack)
