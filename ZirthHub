local function sanitizeName(name)
    return (name:gsub("[^%w_%-]", "_"))
end

local function getConfigPath(name)
    return CONFIG_PREFIX .. sanitizeName(name) .. CONFIG_EXT
end

local function extractFileName(path)
    local filename = path:match("([^/\\]+)$")
    return filename or path
end

local function readManifest()
    local names = {}
    if readfile then
        local ok, content = pcall(readfile, MANIFEST_FILE)
        if ok and content and content ~= "" then
            local ok2, data = pcall(function() return HttpService:JSONDecode(content) end)
            if ok2 and type(data) == "table" then
                for _, v in ipairs(data) do
                    if type(v) == "string" and v ~= "" then
                        table.insert(names, v)
                    end
                end
            end
        end
    end
    return names
end

local function writeManifest(names)
    if not writefile then return false end
    local ok, json = pcall(function() return HttpService:JSONEncode(names) end)
    if not ok then return false end
    return pcall(writefile, MANIFEST_FILE, json)
end

local function addToManifest(name)
    local names = readManifest()
    local exists = false
    for _, n in ipairs(names) do
        if n == name then exists = true; break end
    end
    if not exists then
        table.insert(names, name)
        writeManifest(names)
    end
end

local function removeFromManifest(name)
    local names = readManifest()
    local newNames = {}
    for _, n in ipairs(names) do
        if n ~= name then table.insert(newNames, n) end
    end
    writeManifest(newNames)
end

local function listSavedConfigs()
    local result = {}
    local seen = {}

    for _, name in ipairs(readManifest()) do
        if not seen[name] then
            table.insert(result, name)
            seen[name] = true
        end
    end

    local listFn = listfiles or list_files
    if listFn then
        local ok, files = pcall(listFn)
        if ok and type(files) == "table" then
            for _, rawPath in ipairs(files) do
                local filename = extractFileName(tostring(rawPath))
                if filename:sub(1, #CONFIG_PREFIX) == CONFIG_PREFIX
                and filename:sub(-#CONFIG_EXT) == CONFIG_EXT then
                    local body = filename:sub(#CONFIG_PREFIX + 1)
                    local name = body:sub(1, #body - #CONFIG_EXT)
                    if name ~= "" and not seen[name] then
                        table.insert(result, name)
                        seen[name] = true
                    end
                end
            end
        end
    end

    if Z.ZirthHubConfigs then
        for name in pairs(Z.ZirthHubConfigs) do
            if not seen[name] then
                table.insert(result, name)
                seen[name] = true
            end
        end
    end

    table.sort(result)
    return result
end

local Codec = {}

local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

function Codec.encode(data)
    return ((data:gsub(".", function(x)
        local r, b = "", x:byte()
        for i = 8, 1, -1 do
            r = r .. (b % 2 ^ i - b % 2 ^ (i - 1) > 0 and "1" or "0")
        end
        return r
    end) .. "0000"):gsub("%d%d%d?%d?%d?%d?", function(x)
        if #x < 6 then return "" end
        local c = 0
        for i = 1, 6 do
            c = c + (x:sub(i, i) == "1" and 2 ^ (6 - i) or 0)
        end
        return B64:sub(c + 1, c + 1)
    end) .. ({"", "==", "="})[#data % 3 + 1])
end

function Codec.decode(data)
    data = data:gsub("[^%w%+/=]", "")
    return (data:gsub(".", function(x)
        if x == "=" then return "" end
        local pos = B64:find(x, 1, true)
        if not pos then return "" end
        local r, f = "", pos - 1
        for i = 6, 1, -1 do
            r = r .. (f % 2 ^ i - f % 2 ^ (i - 1) > 0 and "1" or "0")
        end
        return r
    end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(x)
        if #x ~= 8 then return "" end
        local c = 0
        for i = 1, 8 do
            c = c + (x:sub(i, i) == "1" and 2 ^ (8 - i) or 0)
        end
        return string.char(c)
    end))
end

