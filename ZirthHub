local CreateMultiDropdown
do
    -- Multi-select dropdown (Kinon-style popup, Zirth Hub look).
    -- items = { { settingKey, "Label" }, ... }; every item is saved in configs.
    local ROW_H, HEAD_H, MAX_ROWS, POP_W = 30, 26, 6, 190
    local activeClose, activeBtn

    local function closePopup()
        if activeClose then
            local fn = activeClose
            activeClose, activeBtn = nil, nil
            pcall(fn)
        end
    end

    local function reallyShown(gui)
        local o = gui
        while o and o ~= ScreenGui do
            if o:IsA("GuiObject") and not o.Visible then return false end
            o = o.Parent
        end
        return o == ScreenGui
    end

    local function openPopup(btn, titleText, items, settings, onToggle)
        closePopup()
        local shown = math.min(#items, MAX_ROWS)
        local h = HEAD_H + shown * ROW_H + math.max(shown - 1, 0) * 3 + 14
        local openScale = MainScale.Scale

        local popup = Instance.new("Frame")
        popup.Name = "ZirthDropdown"
        popup.Parent = ScreenGui
        popup.BackgroundColor3 = C.Panel
        popup.BorderSizePixel = 0
        popup.Active = true
        popup.ZIndex = 60
        popup.Size = UDim2.fromOffset(POP_W, h)
        corner(popup, 4)

        local stroke = Instance.new("UIStroke", popup)
        stroke.Color = C.Line
        stroke.Thickness = 1

        local popScale = Instance.new("UIScale", popup)
        popScale.Scale = openScale * 0.92
        pcall(function()
            TweenService:Create(popScale, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = openScale }):Play()
        end)

        local head = Instance.new("TextLabel")
        head.Parent = popup
        head.BackgroundTransparency = 1
        head.Position = UDim2.fromOffset(12, 0)
        head.Size = UDim2.new(1, -24, 0, HEAD_H)
        head.Font = Enum.Font.GothamBold
        head.Text = string.upper(titleText)
        head.TextColor3 = C.TextDim
        head.TextSize = 9
        head.TextXAlignment = Enum.TextXAlignment.Left
        head.ZIndex = 61

        local line = Instance.new("Frame")
        line.Parent = popup
        line.BackgroundColor3 = C.Line
        line.BackgroundTransparency = 0.4
        line.BorderSizePixel = 0
        line.Position = UDim2.fromOffset(8, HEAD_H - 1)
        line.Size = UDim2.new(1, -16, 0, 1)
        line.ZIndex = 61

        local scroll = Instance.new("ScrollingFrame")
        scroll.Parent = popup
        scroll.BackgroundTransparency = 1
        scroll.BorderSizePixel = 0
        scroll.Position = UDim2.fromOffset(0, HEAD_H)
        scroll.Size = UDim2.new(1, 0, 1, -HEAD_H)
        scroll.ScrollBarThickness = 3
        scroll.ScrollBarImageColor3 = C.TextDim
        scroll.CanvasSize = UDim2.new()
        scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        scroll.ZIndex = 61

        local pad = Instance.new("UIPadding", scroll)
        pad.PaddingTop = UDim.new(0, 5)
        pad.PaddingBottom = UDim.new(0, 5)
        pad.PaddingLeft = UDim.new(0, 6)
        pad.PaddingRight = UDim.new(0, 8)
        local list = Instance.new("UIListLayout", scroll)
        list.Padding = UDim.new(0, 3)
        list.SortOrder = Enum.SortOrder.LayoutOrder

        local rows = {}
        local function refreshRows()
            for i, r in ipairs(rows) do
                local on = settings[items[i][1]] == true
                r.on = on
                r.btn.BackgroundColor3 = on and Color3.fromRGB(52, 52, 52) or C.Card
                r.lbl.TextColor3 = on and C.Text or C.TextDim
                r.track.BackgroundColor3 = on and C.Active or C.Line
                r.knob.BackgroundColor3 = on and C.ActiveTxt or C.Text
                r.knob.Position = on and UDim2.new(1, -11, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
            end
        end

        for i, item in ipairs(items) do
            local b = Instance.new("TextButton")
            b.Parent = scroll
            b.LayoutOrder = i
            b.Size = UDim2.new(1, 0, 0, ROW_H)
            b.BackgroundColor3 = C.Card
            b.BorderSizePixel = 0
            b.AutoButtonColor = false
            b.Text = ""
            b.ZIndex = 62
            corner(b, 3)

            local lbl = Instance.new("TextLabel")
            lbl.Parent = b
            lbl.BackgroundTransparency = 1
            lbl.Position = UDim2.new(0, 10, 0, 0)
            lbl.Size = UDim2.new(1, -46, 1, 0)
            lbl.Font = Enum.Font.GothamBold
            lbl.Text = item[2]
            lbl.TextColor3 = C.TextDim
            lbl.TextSize = 10
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.TextTruncate = Enum.TextTruncate.AtEnd
            lbl.ZIndex = 63

            local track = Instance.new("Frame")
            track.Parent = b
            track.AnchorPoint = Vector2.new(1, 0.5)
            track.Position = UDim2.new(1, -8, 0.5, 0)
            track.Size = UDim2.fromOffset(23, 13)
            track.BorderSizePixel = 0
            track.BackgroundColor3 = C.Line
            track.ZIndex = 63
            corner(track, 7)

            local knob = Instance.new("Frame")
            knob.Parent = track
            knob.AnchorPoint = Vector2.new(0, 0.5)
            knob.Position = UDim2.new(0, 2, 0.5, 0)
            knob.Size = UDim2.fromOffset(9, 9)
            knob.BorderSizePixel = 0
            knob.BackgroundColor3 = C.Text
            knob.ZIndex = 64
            corner(knob, 5)

            local row = { btn = b, lbl = lbl, track = track, knob = knob, on = false }
            rows[i] = row
            b.MouseEnter:Connect(function()
                if not row.on then b.BackgroundColor3 = C.CardHover end
            end)
            b.MouseLeave:Connect(function()
                if not row.on then b.BackgroundColor3 = C.Card end
            end)
            b.MouseButton1Click:Connect(function()
                onToggle(item[1], not (settings[item[1]] == true))
                refreshRows()
            end)
        end
        refreshRows()

        local function place()
            local sc = openScale
            local ap, as = btn.AbsolutePosition, btn.AbsoluteSize
            local pw, ph = POP_W * sc, h * sc
            local x = ap.X + as.X - pw
            local y = ap.Y + as.Y + 4
            local screen = ScreenGui.AbsoluteSize
            if y + ph > screen.Y then y = ap.Y - ph - 4 end
            x = math.clamp(x, 4, math.max(4, screen.X - pw - 4))
            popup.Position = UDim2.fromOffset(x, math.max(4, y))
        end
        place()

        local conns = {}
        conns[#conns + 1] = RunService.RenderStepped:Connect(function()
            if not popup.Parent or not reallyShown(btn) or not MainFrame.Visible
                or math.abs(MainScale.Scale - openScale) > 0.001 then
                closePopup()
                return
            end
            local hp, hs = ContentHolder.AbsolutePosition, ContentHolder.AbsoluteSize
            local bp, bs = btn.AbsolutePosition, btn.AbsoluteSize
            if bp.Y < hp.Y or bp.Y + bs.Y > hp.Y + hs.Y then
                closePopup()
                return
            end
            place()
        end)
        conns[#conns + 1] = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then return end
            local p = Vector2.new(input.Position.X, input.Position.Y)
            local function inside(f)
                local fp, fs = f.AbsolutePosition, f.AbsoluteSize
                return p.X >= fp.X and p.X <= fp.X + fs.X and p.Y >= fp.Y and p.Y <= fp.Y + fs.Y
            end
            if inside(popup) or inside(btn) then return end
            closePopup()
        end)

        activeBtn = btn
        activeClose = function()
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
            popup:Destroy()
        end
    end

    CreateMultiDropdown = function(parentFrame, titleText, items, settings, onChange, idPrefix, exclusive, noRegister)
        local wrap = Instance.new("Frame")
        wrap.Parent = parentFrame
        wrap.BackgroundColor3 = C.Card
        wrap.Size = UDim2.new(1, -6, 0, 38)
        wrap.BorderSizePixel = 0
        corner(wrap, 2)
        local wstroke = Instance.new("UIStroke", wrap)
        wstroke.Color = C.Line
        wstroke.Thickness = 1
        wstroke.Transparency = 0.5

        local title = Instance.new("TextLabel")
        title.Parent = wrap
        title.BackgroundTransparency = 1
        title.Position = UDim2.new(0, 12, 0, 0)
        title.Size = UDim2.new(1, -150, 1, 0)
        title.Font = Enum.Font.GothamBold
        title.Text = titleText
        title.TextColor3 = C.Text
        title.TextSize = 12
        title.TextXAlignment = Enum.TextXAlignment.Left

        local btn = Instance.new("TextButton")
        btn.Parent = wrap
        btn.AnchorPoint = Vector2.new(1, 0.5)
        btn.Position = UDim2.new(1, -8, 0.5, 0)
        btn.Size = UDim2.fromOffset(122, 24)
        btn.BackgroundColor3 = C.Panel
        btn.BorderSizePixel = 0
        btn.AutoButtonColor = false
        btn.Text = ""
        corner(btn, 3)
        local bstroke = Instance.new("UIStroke", btn)
        bstroke.Color = C.Line
        bstroke.Thickness = 1
        bstroke.Transparency = 0.35

        local cur = Instance.new("TextLabel")
        cur.Parent = btn
        cur.BackgroundTransparency = 1
        cur.Position = UDim2.new(0, 8, 0, 0)
        cur.Size = UDim2.new(1, -26, 1, 0)
        cur.Font = Enum.Font.GothamBold
        cur.TextColor3 = C.Text
        cur.TextSize = 10
        cur.TextXAlignment = Enum.TextXAlignment.Left
        cur.TextTruncate = Enum.TextTruncate.AtEnd

        local _, chevron = BuildIcon(btn, "chevron-down", 12, UDim2.new(1, -13, 0.5, 0))
        chevron.ImageColor3 = C.TextDim
        chevron.ZIndex = 5

        local function renderValue()
            local n, first = 0, nil
            for _, it in ipairs(items) do
                if settings[it[1]] == true then
                    n = n + 1
                    first = first or it[2]
                end
            end
            cur.Text = n == 0 and "None" or (n == 1 and first or (n .. " selected"))
            cur.TextColor3 = n == 0 and C.TextDim or C.Text
        end
        renderValue()

        local function apply(key, value)
            value = value == true
            if exclusive then
                if value then
                    for _, it in ipairs(items) do settings[it[1]] = false end
                    settings[key] = true
                else
                    settings[key] = false
                    renderValue()
                    return
                end
            else
                settings[key] = value
            end
            renderValue()
            if onChange then
                local ok, err = pcall(onChange, key, settings[key])
                if not ok then warn("Zirth Hub: " .. titleText .. " - " .. tostring(err)) end
            end
        end

        btn.MouseButton1Click:Connect(function()
            if activeBtn == btn then closePopup() return end
            openPopup(btn, titleText, items, settings, apply)
        end)
        btn.MouseEnter:Connect(function() bstroke.Transparency = 0.05 end)
        btn.MouseLeave:Connect(function() bstroke.Transparency = 0.35 end)

        for _, it in ipairs(items) do
            local key = it[1]
            local id = (idPrefix or "dd") .. "_" .. string.lower(key)
            if not noRegister then
                ToggleRegistry[id] = {
                    name = titleText .. " - " .. it[2],
                    getState = function() return settings[key] == true end,
                    setState = function(v) apply(key, v) end,
                }
            end
            table.insert(SearchItems, { name = it[2], obj = wrap })
        end
        table.insert(SearchItems, { name = titleText, obj = wrap })
        return wrap
    end
end

-- ===== SURVIVOR UTILITIES (ported from Kinon): Always Fast Vault, Unlimited Vault, Auto Dodge Abyss =====
State.UtilS = { AbyssDodgeRange = 40 }
State.UtilityHandlers = {}

do -- Always Fast Vault
    local enabled = false
    local conn

    local function installHooks()
        local rs = game:GetService("ReplicatedStorage")
        local dynRequire = rawget(_G, "require") or require
        pcall(function()
            local module = dynRequire(rs:WaitForChild("Modules"):WaitForChild("Survivors"):WaitForChild("SurvivorVault"))
            if module and type(module.evaluate) == "function" and not module._VDFastVaultHooked then
                module._VDOriginalEvaluate = module.evaluate
                module.evaluate = function(self, ...)
                    if enabled then return true, "ready", 5 end
                    return module._VDOriginalEvaluate(self, ...)
                end
                module._VDFastVaultHooked = true
            end
        end)
        pcall(function()
            local module = dynRequire(rs:WaitForChild("Modules"):WaitForChild("Survivors"):WaitForChild("SurvivorAnimationsController"))
            if module and type(module._validateFastVault) == "function" and not module._VDFastVaultHooked then
                module._VDOriginalValidateFastVault = module._validateFastVault
                module._validateFastVault = function(self, ...)
                    if enabled then return true, "ready", 5 end
                    return module._VDOriginalValidateFastVault(self, ...)
                end
                module._VDFastVaultHooked = true
            end
        end)
    end

    local function runInstall()
        task.spawn(function()
            for _ = 1, 20 do
                if unloaded or not enabled then break end
                installHooks()
                task.wait(0.25)
            end
        end)
    end

    State.UtilityHandlers.AlwaysFastVault = function(state)
        enabled = state and true or false
        if conn then conn:Disconnect(); conn = nil end
        if enabled then
            runInstall()
            conn = track(LP.CharacterAdded:Connect(runInstall))
        end
    end
end

