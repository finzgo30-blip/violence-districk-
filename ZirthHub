-- Safety parry killer: vault window / break pallet
do
	local E = KINON_ParryEngine
	E.Objects = {}
	for _, w in ipairs({ "climb", "hurdle", "smash", "mantle", "slide" }) do
		table.insert(KINON_KillerObjectWords, w)
		table.insert(KINON_KillerAttrWords, w)
	end
	local function matchName(inst)
		local n = string.lower(inst.Name)
		return n:find("pallet", 1, true) or n:find("vault", 1, true) or n:find("window", 1, true)
	end
	local function scan()
		local list, count = {}, 0
		local poss = {}
		for _, inst in ipairs(workspace:GetDescendants()) do
			count += 1
			if count % 1500 == 0 then task.wait() end
			if (inst:IsA("Model") or inst:IsA("BasePart")) and matchName(inst) then
				local par = inst.Parent
				if not (par and (par:IsA("Model") and matchName(par))) then
					list[#list + 1] = inst
					local okp, pp = pcall(function()
						return inst:IsA("Model") and inst:GetPivot().Position or inst.Position
					end)
					if okp and pp then poss[#poss + 1] = pp end
				end
			end
		end
		E.Objects = list
		E.ObjPos = poss
	end
	task.spawn(function()
		while not unloaded do
			if E.UseObjectGuard and (Parry.Enabled or ParryV2.Enabled) then pcall(scan); task.wait(20) else task.wait(1) end
		end
	end)
	local function flat(v) return Vector3.new(v.X, 0, v.Z) end
	-- true kalau killer sedang menghadap pallet/jendela di dekatnya (bukan menyerang kita)
	E.NearCache = setmetatable({}, { __mode = "k" })
	function E.NearObjectAction(model, playerRoot, strict)
		local now = tick()
		local c = E.NearCache[model]
		if c and c.strict == (strict == true) and now - c.t < 0.1 then return c.v end
		local result = false
		local kr = model and model:FindFirstChild("HumanoidRootPart")
		local poss = E.ObjPos
		if kr and playerRoot and poss and #poss > 0 then
			local look = flat(kr.CFrame.LookVector)
			if look.Magnitude >= 0.05 then
				look = look.Unit
				local kp = kr.Position
				local toMe = flat(playerRoot.Position - kp)
				local meDist = toMe.Magnitude
				local meDot = meDist > 0.1 and look:Dot(toMe.Unit) or 1
				if strict or meDist > 5 then
					for i = 1, #poss do
						local pos = poss[i]
						local dx, dz = pos.X - kp.X, pos.Z - kp.Z
						local d2 = dx * dx + dz * dz
						if d2 <= 36 and d2 > 0.01 then
							local d = math.sqrt(d2)
							local objDot = (look.X * dx + look.Z * dz) / d
							if objDot > 0.75 and (meDot < 0.6 or (d <= 4 and meDist > d + 1.5)) then
								result = true
								break
							end
						end
					end
				end
			end
		end
		E.NearCache[model] = { t = now, v = result, strict = strict == true }
		return result
	end

	-- cooldown dagger: baca dari client/tool, belajar dari flag isParryOnCooldown
	function E.ReadCD(client)
		local function scan(t)
			for k, v in pairs(t) do
				if type(k) == "string" and type(v) == "number" and v >= 0.2 and v <= 30 then
					local n = string.lower(k)
					if n:find("cool", 1, true) and not n:find("until", 1, true)
						and not n:find("last", 1, true) and not n:find("tick", 1, true)
						and not n:find("time", 1, true) then return v end
				end
			end
		end
		if type(client) == "table" then
			local ok, v = pcall(scan, client)
			if ok and v then return v end
			local mt = getmetatable(client)
			if type(mt) == "table" and type(mt.__index) == "table" then
				ok, v = pcall(scan, mt.__index)
				if ok and v then return v end
			end
		end
		local tool = KINON_GetParryTool()
		if typeof(tool) == "Instance" then
			local ok, attrs = pcall(function() return tool:GetAttributes() end)
			if ok and type(attrs) == "table" then
				local v = scan(attrs)
				if v then return v end
			end
		end
		return nil
	end
	function E.GetCD(client)
		if E.LearnedCD then return E.LearnedCD end
		return E.ReadCD(client) or 0.8
	end
	function E.Observe()
		local c = KINON_FindParryClient(true)
		if not c then return end
		local on = c.isParryOnCooldown and true or false
		if on and not E.ObsOn then
			E.ObsOn, E.ObsT0, E.FlagWorks = true, tick(), true
		elseif not on and E.ObsOn then
			E.ObsOn = false
			local d = tick() - (E.ObsT0 or tick())
			if d > 0.1 and d < 30 then E.LearnedCD = d * 0.9 end
		end
	end

	-- parry siap dipakai? (dipakai Auto Dodge Abyss: crouch hanya saat parry TIDAK siap)
	function E.ParryReady()
		if tick() < (E.CDUntil or 0) then return false end
		local client = KINON_FindParryClient(true)
		if not client then return false end
		if client.isParryOnCooldown or client.isParryResolving then return false end
		return true
	end

	-- gerbang murah: jangan cek berat tiap frame kalau parry masih cooldown/resolving
	function E.Gate()
		local now = tick()
		if now < (E.CDUntil or 0) then return false end
		if now - (E.LastSuccess or 0) < 0.03 then return false end
		local client = KINON_FindParryClient(true)
		if client and (client.isParryOnCooldown or client.isParryResolving) then
			if now - (E.GateAt or 0) > 0.05 then E.GateAt = now; return true end
			return false
		end
		return true
	end
end

local function KINON_KillerDoingObjectAction(model, currentTrack)
