local currentActiveSlide = nil

local function updateFades()
    if not currentActiveSlide then
        TopFade.Visible = false
        BottomFade.Visible = false
        return
    end
    local slide = currentActiveSlide
    local scrollPos = slide.CanvasPosition.Y
    local canvasH = slide.CanvasSize.Y.Offset
    local viewH = slide.AbsoluteSize.Y
    local maxScroll = math.max(0, canvasH - viewH)

    TopFade.Visible = scrollPos > 2
    BottomFade.Visible = maxScroll > 2 and scrollPos < maxScroll - 2
end

local function BuildIcon(parent, iconName, size, position)
    size = size or 14
    position = position or UDim2.new(0.5, 0, 0.5, 0)
    local Img
    if Lucide then
        local ok, res = pcall(function()
            return Lucide.ImageLabel(iconName, 48, {
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = position,
                Size = UDim2.new(0, size, 0, size),
                ImageColor3 = C.Text,
                ZIndex = 4,
                Parent = parent,
            })
        end)
        if ok then Img = res end
    end
    if not Img then
        Img = Instance.new("ImageLabel")
        Img.BackgroundTransparency = 1
        Img.AnchorPoint = Vector2.new(0.5, 0.5)
        Img.Position = position
        Img.Size = UDim2.new(0, size, 0, size)
        Img.Image = ICON_FALLBACK[iconName] or ""
        Img.ImageColor3 = C.Text
        Img.ScaleType = Enum.ScaleType.Fit
        Img.ZIndex = 4
        Img.Parent = parent
    end
    return function(color)
        Img.ImageColor3 = color
    end, Img
end

