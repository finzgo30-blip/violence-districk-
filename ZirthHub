    tracer.Name = "TargetTracer"
    tracer.AnchorPoint = Vector2.new(0.5, 0.5)
    tracer.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    tracer.BackgroundTransparency = 0.1
    tracer.BorderSizePixel = 0
    tracer.Visible = false
    tracer.Parent = sg

    local targetHL = Instance.new("Highlight")
    targetHL.Name = "ZirthSpearHL"
    targetHL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    targetHL.FillColor = TARGET_COLOR
    targetHL.OutlineColor = Color3.fromRGB(255, 255, 255)
    targetHL.FillTransparency = 0.6
    targetHL.OutlineTransparency = 0
    targetHL.Enabled = false

    local function hideVisuals()
        pcall(function() ring.Enabled = false; ring.Adornee = nil; ring.Parent = nil end)
        pcall(function() tracer.Visible = false end)
        pcall(function() targetHL.Enabled = false; targetHL.Adornee = nil; targetHL.Parent = nil end)
    end

    V.DestroyEsp = function()
        V.TargetChar = nil
        hideVisuals()
        tracker.char, tracker.samples = nil, {}
    end

    local function isKillerMe() return LP.Team ~= nil and LP.Team.Name == "Killer" end

    V.RenderConn = RunService.RenderStepped:Connect(function()
        updateFovCircle(not unloaded and V.Enabled and V.ShowFov and isKillerMe())
        if unloaded or not V.Enabled then
            if V.TargetChar or ring.Enabled or tracer.Visible then V.DestroyEsp() end
            return
        end
        local t = pick(candidates())
        local nowC = os.clock()
        if t then
            V.LastT, V.LastSeen = t, nowC
        elseif V.LastT and nowC - (V.LastSeen or 0) < 0.3 then
            local lt = V.LastT
            if lt.hrp and lt.hrp.Parent and lt.hum and lt.hum.Parent and lt.hum.Health > 0 then t = lt end
        end
        V.TargetChar = t and t.char or nil
        if not isKillerMe() then
            V.TargetChar = nil
            hideVisuals()
            return
        end
        if V.TargetChar then
            local hrp = t.hrp
            trackTarget(V.TargetChar, hrp)
            if ring.Adornee ~= hrp or ring.Parent ~= hrp then
                ring.Parent = hrp
                ring.Adornee = hrp
            end
            ring.Enabled = true

            if V.ShowHL then
                if targetHL.Adornee ~= V.TargetChar or targetHL.Parent ~= V.TargetChar then
                    targetHL.Parent = V.TargetChar
                    targetHL.Adornee = V.TargetChar
                end
                targetHL.Enabled = true
            else
                targetHL.Enabled = false
            end

            local cam = workspace.CurrentCamera
            local sp, on = cam:WorldToViewportPoint(hrp.Position)
            if V.ShowTracer and on and sp.Z > 0 then
                local vp = cam.ViewportSize
                local from = Vector2.new(vp.X / 2, vp.Y / 2)
                local to = Vector2.new(sp.X, sp.Y)
                local d = to - from
                tracer.Size = UDim2.fromOffset(d.Magnitude, 1.5)
                tracer.Position = UDim2.fromOffset((from.X + to.X) / 2, (from.Y + to.Y) / 2)
                tracer.Rotation = math.deg(math.atan2(d.Y, d.X))
                tracer.Visible = true
            else
                tracer.Visible = false
            end
        else
            hideVisuals()
            tracker.char, tracker.samples = nil, {}
        end
    end)

    V.Destroy = function()
        V.Enabled = false
        V.Dead = true
        if V.RenderConn then pcall(function() V.RenderConn:Disconnect() end); V.RenderConn = nil end
        pcall(function() ring:Destroy() end)
        pcall(function() targetHL:Destroy() end)
        pcall(function() sg:Destroy() end)
        V.TargetChar = nil
    end

    if not V.Installed.namecall and hookmetamethod and getnamecallmethod then
        pcall(function()
            local old
            old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
                local method = getnamecallmethod()
                if method == "FireServer" or method == "fireServer" then
                    local cur = G.ZirthSilentSpear
                    local handler = cur and cur.NamecallHandler
                    if handler then return handler(old, self, ...) end
                end
                if setnamecallmethod and method then setnamecallmethod(method) end
                return old(self, ...)
            end))
            V.Installed.namecall = true
        end)
    end
    V.HookOk = V.Installed.namecall == true

    return V
end)()

State.CreateDropdown = function(parentFrame, titleText, values, current, callback, idPrefix, noRegister)
    local sel, items = {}, {}
    for _, v in ipairs(values) do
        items[#items + 1] = { v, v }
        sel[v] = (v == current)
    end
    if current == nil or sel[current] == nil then sel[values[1]] = true end
    return CreateMultiDropdown(parentFrame, titleText, items, sel, function(key, on)
        if on and callback then callback(key) end
    end, idPrefix, true, noRegister)
end

