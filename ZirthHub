		elseif method == 2 and usable and type(firesignal) == "function" then
			done = pcall(function()
				firesignal(btn.MouseButton1Down)
				if btn:IsA("GuiButton") then firesignal(btn.Activated, Enum.UserInputType.Touch, 0) end
				task.wait(hold)
				firesignal(btn.MouseButton1Up)
				if btn:IsA("GuiButton") then firesignal(btn.MouseButton1Click) end
			end)
