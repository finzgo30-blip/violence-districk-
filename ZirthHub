-- ===== WORLD SETTINGS: Fullbright / Day Time / No Fog / No Shadow / Low Graphic / Clean Sky =====
do
    if type(Z.ZirthWorldRestore) == "function" then pcall(Z.ZirthWorldRestore) end

    local W = { Fullbright = false, DayTime = false, NoFog = false, NoShadow = false, LowGraphic = false, CleanSky = false }
    State.WorldFX = W

    local FULLBRIGHT_COLOR = Color3.fromRGB(178, 178, 178)
    local clockTime = 14

    -- plain Lighting properties: snapshot when switched on, put back when switched off
    local LIGHT_FX = {
        Fullbright = {
            keys = { "Brightness", "Ambient", "OutdoorAmbient", "ExposureCompensation" },
            apply = function()
                Lighting.Brightness = 2
                Lighting.Ambient = FULLBRIGHT_COLOR
                Lighting.OutdoorAmbient = FULLBRIGHT_COLOR
                Lighting.ExposureCompensation = 0
            end,
        },
        DayTime = {
            keys = { "ClockTime" },
            apply = function() Lighting.ClockTime = math.clamp(tonumber(clockTime) or 14, 0, 24) end,
        },
        NoFog = {
            keys = { "FogStart", "FogEnd" },
            apply = function()
                Lighting.FogStart = 9e8
                Lighting.FogEnd = 9e8
            end,
        },
        NoShadow = {
            keys = { "GlobalShadows", "ShadowSoftness" },
            apply = function()
                Lighting.GlobalShadows = false
                pcall(function() Lighting.ShadowSoftness = 0 end)
            end,
        },
    }
    local lightSnap = {}

    local function snapLighting(name)
        local t = {}
        for _, k in ipairs(LIGHT_FX[name].keys) do
            local ok, v = pcall(function() return Lighting[k] end)
            if ok then t[k] = v end
        end
        lightSnap[name] = t
    end
    local function restoreLighting(name)
        local t = lightSnap[name]
        if not t then return end
        for k, v in pairs(t) do pcall(function() Lighting[k] = v end) end
        lightSnap[name] = nil
    end
    local function applyLighting(name)
        pcall(LIGHT_FX[name].apply)
    end

    -- Atmosphere (fog haze, glare)
    local atmoOrig = setmetatable({}, { __mode = "k" })
    local function refreshAtmosphere()
        local want = W.NoFog or W.CleanSky
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("Atmosphere") then
                if want then
                    if not atmoOrig[obj] then
                        atmoOrig[obj] = { Density = obj.Density, Haze = obj.Haze, Glare = obj.Glare }
                    end
                    if W.NoFog then obj.Density = 0 end
                    obj.Haze = 0
                    if W.CleanSky then obj.Glare = 0 end
                elseif atmoOrig[obj] then
                    for k, v in pairs(atmoOrig[obj]) do pcall(function() obj[k] = v end) end
                    atmoOrig[obj] = nil
                end
            end
        end
        if not want then
            for obj, o in pairs(atmoOrig) do
                for k, v in pairs(o) do pcall(function() obj[k] = v end) end
                atmoOrig[obj] = nil
            end
        end
    end

    -- post effects (bloom, blur, sun rays, depth of field)
    local effOrig = setmetatable({}, { __mode = "k" })
    local function effectShouldBeOff(eff)
        if eff:IsA("SunRaysEffect") then return W.LowGraphic or W.CleanSky end
        if eff:IsA("BloomEffect") or eff:IsA("BlurEffect") or eff:IsA("DepthOfFieldEffect") then return W.LowGraphic end
        return false
    end
    local function refreshEffects()
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("PostEffect") then
                if effectShouldBeOff(obj) then
                    if effOrig[obj] == nil then effOrig[obj] = obj.Enabled end
                    obj.Enabled = false
                elseif effOrig[obj] ~= nil then
                    obj.Enabled = effOrig[obj]
                    effOrig[obj] = nil
                end
            end
        end
    end

    -- sky + clouds
    local skyOrig = setmetatable({}, { __mode = "k" })
    local cloudOrig = setmetatable({}, { __mode = "k" })
    local function refreshSky()
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("Sky") then
                if W.CleanSky then
                    if not skyOrig[obj] then
                        skyOrig[obj] = { StarCount = obj.StarCount, CelestialBodiesShown = obj.CelestialBodiesShown }
                    end
                    obj.StarCount = 0
                    obj.CelestialBodiesShown = false
                elseif skyOrig[obj] then
                    for k, v in pairs(skyOrig[obj]) do pcall(function() obj[k] = v end) end
                    skyOrig[obj] = nil
                end
            end
        end
        local terrain = workspace:FindFirstChildOfClass("Terrain")
        local clouds = terrain and terrain:FindFirstChildOfClass("Clouds")
        if clouds then
            if W.CleanSky then
                if cloudOrig[clouds] == nil then cloudOrig[clouds] = clouds.Enabled end
                clouds.Enabled = false
            elseif cloudOrig[clouds] ~= nil then
                clouds.Enabled = cloudOrig[clouds]
                cloudOrig[clouds] = nil
            end
        end
    end

    -- low graphic: quality level, plain materials, no shadows/reflections/particles
    local partOrig = setmetatable({}, { __mode = "k" })
    local qualityOrig
    local scanToken = 0
    local descConn

    local function isCharacterPart(obj)
        local m = obj:FindFirstAncestorOfClass("Model")
        return m ~= nil and m:FindFirstChildOfClass("Humanoid") ~= nil
    end
    local function lowerObject(obj)
        if partOrig[obj] then return end
        if obj:IsA("BasePart") then
            if isCharacterPart(obj) then return end
            partOrig[obj] = { Material = obj.Material, Reflectance = obj.Reflectance, CastShadow = obj.CastShadow }
            obj.Material = Enum.Material.SmoothPlastic
            obj.Reflectance = 0
            obj.CastShadow = false
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
            partOrig[obj] = { Enabled = obj.Enabled }
            obj.Enabled = false
        end
    end
    local function restoreObject(obj, o)
        for k, v in pairs(o) do pcall(function() obj[k] = v end) end
    end

    local function startLowGraphic()
        scanToken = scanToken + 1
        local token = scanToken
        pcall(function()
            local r = settings().Rendering
            if qualityOrig == nil then qualityOrig = r.QualityLevel end
            r.QualityLevel = Enum.QualityLevel.Level01
        end)
        pcall(function()
            local terrain = workspace:FindFirstChildOfClass("Terrain")
            if terrain then terrain.WaterWaveSize = 0; terrain.WaterReflectance = 0 end
        end)
        if descConn then descConn:Disconnect() end
        descConn = workspace.DescendantAdded:Connect(function(obj)
            if W.LowGraphic and not unloaded then pcall(lowerObject, obj) end
        end)
        task.spawn(function()
            local n = 0
            for _, obj in ipairs(workspace:GetDescendants()) do
                if token ~= scanToken or unloaded or not W.LowGraphic then return end
                pcall(lowerObject, obj)
                n = n + 1
                if n % 400 == 0 then task.wait() end
            end
        end)
    end

    local function stopLowGraphic()
        scanToken = scanToken + 1
        if descConn then descConn:Disconnect(); descConn = nil end
        pcall(function()
            if qualityOrig ~= nil then settings().Rendering.QualityLevel = qualityOrig end
            qualityOrig = nil
        end)
        task.spawn(function()
            local n = 0
            for obj, o in pairs(partOrig) do
                if W.LowGraphic then return end
                if obj.Parent then restoreObject(obj, o) end
                partOrig[obj] = nil
                n = n + 1
                if n % 400 == 0 then task.wait() end
            end
        end)
    end

    local function refreshShared()
        pcall(refreshAtmosphere)
        pcall(refreshEffects)
        pcall(refreshSky)
    end

    local function setFX(name, state)
        state = state == true
        if W[name] == state then return end
        W[name] = state
        if LIGHT_FX[name] then
            if state then
                snapLighting(name)
                applyLighting(name)
            else
                restoreLighting(name)
            end
        end
        if name == "LowGraphic" then
            if state then startLowGraphic() else stopLowGraphic() end
        end
        refreshShared()
    end

    -- the game may rewrite Lighting (day/night cycle, fog, ...): keep our values in place
    task.spawn(function()
        local tick = 0
