local function collectCurrentState()
    local data = {toggles = {}, sliders = {}}
    for id, t in pairs(ToggleRegistry) do
        data.toggles[id] = t.getState()
    end
    for id, sl in pairs(SliderRegistry) do
        data.sliders[id] = sl.getValue()
    end
    return data
