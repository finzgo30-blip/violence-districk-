local RefreshConfigList

local function persistConfig(name, data)
    local ok, json = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok then
        ShowToast("Save Failed", "Encode error")
        return false
    end

    local savedToFile = false
    if writefile then
        savedToFile = pcall(writefile, getConfigPath(name), json)
    end

    Z.ZirthHubConfigs = Z.ZirthHubConfigs or {}
    Z.ZirthHubConfigs[name] = data

    if savedToFile then
        addToManifest(name)
    end

    if RefreshConfigList then RefreshConfigList() end
    return true
end

local function SaveConfigNamed(name)
    if not name or name == "" then
        ShowToast("Save Failed", "Enter a config name first")
        return false
    end
    name = sanitizeName(name)
    if persistConfig(name, collectCurrentState()) then
        ShowToast("Config Saved", name)
        return true
    end
    return false
end

local function applyConfigData(data)
    local toggles, sliders = data.toggles, data.sliders
    if type(toggles) ~= "table" and type(sliders) ~= "table" then
        toggles, sliders = data, {}
    end
    toggles = type(toggles) == "table" and toggles or {}
    sliders = type(sliders) == "table" and sliders or {}

    local count = 0
    for id, state in pairs(toggles) do
        if ToggleRegistry[id] and type(state) == "boolean" then
            ToggleRegistry[id].setState(state, true)
            count = count + 1
        end
    end
    for id, value in pairs(sliders) do
        if SliderRegistry[id] and type(value) == "number" then
            SliderRegistry[id].setValue(value)
            count = count + 1
        end
    end
    return count
end

local function LoadConfigNamed(name)
    if not name or name == "" then
        ShowToast("Load Failed", "Config name required")
        return false
    end

    name = sanitizeName(name)
    local json

    if readfile then
        local ok, content = pcall(readfile, getConfigPath(name))
        if ok and content then json = content end
    end

    if not json and Z.ZirthHubConfigs and Z.ZirthHubConfigs[name] then
        json = HttpService:JSONEncode(Z.ZirthHubConfigs[name])
    end

    if not json then
        ShowToast("Load Failed", "'" .. name .. "' not found")
        return false
    end

    local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
    if not ok or type(data) ~= "table" then
        ShowToast("Load Failed", "Invalid config")
        return false
    end

    local count = applyConfigData(data)
    ShowToast("Config Loaded", name .. " (" .. count .. ")")
    return true
end

local function DeleteConfigNamed(name)
    if not name or name == "" then
        ShowToast("Delete Failed", "Config name required")
        return false
    end

    name = sanitizeName(name)
    local removed = false

    if delfile then
        removed = pcall(delfile, getConfigPath(name))
    end

    if Z.ZirthHubConfigs and Z.ZirthHubConfigs[name] then
        Z.ZirthHubConfigs[name] = nil
        removed = true
    end

    removeFromManifest(name)

    if settings.autoload == name then
        settings.autoload = ""
        saveSettings()
    end

    if removed then
        ShowToast("Deleted", name)
    else
        ShowToast("Delete Failed", "Config not found")
    end
    return removed
end

