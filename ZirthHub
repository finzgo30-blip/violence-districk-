    corner(Box, 2)

    local BoxStroke = Instance.new("UIStroke", Box)
    BoxStroke.Color = C.Line
    BoxStroke.Thickness = 1

    local _, Icon = BuildIcon(Box, "move-diagonal-2", 12)
    if Icon.Image == "" then
        -- cadangan kalau ikon Lucide gagal dimuat
        for i = 1, 3 do
            local Line = Instance.new("Frame")
            Line.Parent = Box
            Line.BackgroundColor3 = C.Text
            Line.BorderSizePixel = 0
            Line.AnchorPoint = Vector2.new(0.5, 0.5)
            Line.Position = UDim2.new(0, 3 + i * 3, 0, 3 + i * 3)
            Line.Size = UDim2.new(0, 16 - i * 4, 0, 1)
            Line.Rotation = -45
        end
    end

    local activeInput, startInput, startW, startH, startPos

    Grip.InputBegan:Connect(function(input)
        if activeInput then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            activeInput = input
            startInput = input.Position
            startW, startH = UI_Z, UI_H
            startPos = MainFrame.Position
            BoxStroke.Color = C.Text
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not activeInput then return end
        local isMouse = activeInput.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseMovement
        if input ~= activeInput and not isMouse then return end

        local scale = MainScale.Scale
        local screen = ScreenGui.AbsoluteSize
        local delta = input.Position - startInput
        local maxW = math.max(MIN_W, math.min(MAX_W, screen.X / scale))
        local maxH = math.max(MIN_H, math.min(MAX_H, screen.Y / scale))
        UI_Z = math.floor(math.clamp(startW + delta.X / scale, MIN_W, maxW))
        UI_H = math.floor(math.clamp(startH + delta.Y / scale, MIN_H, maxH))

        -- pojok kiri atas tetap di tempat
        MainFrame.Position = startPos + UDim2.fromOffset((UI_Z - startW) * scale / 2, (UI_H - startH) * scale / 2)
        MainFrame.Size = UDim2.new(0, UI_Z, 0, UI_H)
        InfoBar.Visible = UI_Z >= 440
    end)

    UserInputService.InputEnded:Connect(function(input)
        if not activeInput then return end
        if input == activeInput or input.UserInputType == Enum.UserInputType.MouseButton1 then
            activeInput = nil
            BoxStroke.Color = C.Line
        end
    end)
end

local isOpen = false

local function OpenUI()
    if isOpen then return end
    isOpen = true
    MainFrame.Visible = true
    MainFrame.Size = UDim2.new(0, 0, 0, 0)
    TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, UI_Z, 0, UI_H)
    }):Play()
    if RefreshConfigList then RefreshConfigList() end
    task.defer(updateFades)
end

local function CloseUI()
    if not isOpen then return end
    isOpen = false
    TweenService:Create(MainFrame, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0)
    }):Play()
    task.wait(0.22)
    MainFrame.Visible = false
end

OpenButton.MouseButton1Click:Connect(function()
    if isOpen then CloseUI() else OpenUI() end
end)

CloseBtn.MouseButton1Click:Connect(function()
    ShowConfirm(
        "Close Zirth Hub?",
        "Are you sure you want to close this UI? You can reopen it anytime using the floating button.",
        function() CloseUI() end,
        function() end
    )
end)

MinBtn.MouseButton1Click:Connect(function() CloseUI() end)

OpenUI()

ShowToast("Zirth Hub", "Welcome, " .. LocalPlayer.DisplayName)
print("Zirth Hub UI loaded - " .. VERSION)
