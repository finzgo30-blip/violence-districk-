    local ValBox = Instance.new("TextBox")
    ValBox.Parent = Frame
    ValBox.BackgroundColor3 = C.Active
    ValBox.Position = UDim2.new(1, -64, 0, 6)
    ValBox.Size = UDim2.new(0, 54, 0, 22)
    ValBox.BorderSizePixel = 0
    ValBox.Font = Enum.Font.GothamBold
    ValBox.Text = tostring(defaultVal) .. suffix
    ValBox.TextColor3 = C.ActiveTxt
    ValBox.PlaceholderText = minVal .. "-" .. maxVal
    ValBox.PlaceholderColor3 = C.TextSub
    ValBox.TextSize = 11
    ValBox.TextXAlignment = Enum.TextXAlignment.Center
    ValBox.ClearTextOnFocus = true
    ValBox.ClipsDescendants = true
    corner(ValBox, 2)

    local BarWrap = Instance.new("Frame")
    BarWrap.Parent = Frame
    BarWrap.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
    BarWrap.Position = UDim2.new(0, 12, 0, 39)
    BarWrap.Size = UDim2.new(1, -24, 0, 8)
    BarWrap.BorderSizePixel = 0
    corner(BarWrap, 2)

    local BarStroke = Instance.new("UIStroke", BarWrap)
    BarStroke.Color = Color3.fromRGB(25, 25, 25)
    BarStroke.Thickness = 1

    local Fill = Instance.new("Frame")
    Fill.Parent = BarWrap
    Fill.BackgroundColor3 = C.Active
    Fill.Size = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 1, 0)
    Fill.BorderSizePixel = 0
    corner(Fill, 2)

    local FillGrad = Instance.new("UIGradient", Fill)
    FillGrad.Rotation = 0
    FillGrad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(180, 180, 180)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))
    }

    local Knob = Instance.new("Frame")
    Knob.Parent = BarWrap
    Knob.BackgroundColor3 = C.Active
    Knob.AnchorPoint = Vector2.new(0.5, 0.5)
    Knob.Position = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 0.5, 0)
    Knob.Size = UDim2.new(0, 16, 0, 16)
    Knob.BorderSizePixel = 0
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

    local KnobStroke = Instance.new("UIStroke", Knob)
    KnobStroke.Color = Color3.fromRGB(20, 20, 20)
    KnobStroke.Thickness = 1

    local dragging = false
    local locked = false
    local cancelled = false
    local activeInput = nil
    local startPos = nil
    local scroller = nil
    local THRESH = 6
    local current = defaultVal

    local function updateFromX(x)
        local rel = math.clamp((x - BarWrap.AbsolutePosition.X) / BarWrap.AbsoluteSize.X, 0, 1)
        local value = math.floor(minVal + (maxVal - minVal) * rel + 0.5)
        Fill.Size = UDim2.new(rel, 0, 1, 0)
        Knob.Position = UDim2.new(rel, 0, 0.5, 0)
        ValBox.Text = tostring(value) .. suffix
        current = value
        if callback then callback(value) end
    end

    local Hit = Instance.new("Frame")
    Hit.Parent = Frame
    Hit.BackgroundTransparency = 1
    Hit.Position = UDim2.new(0, 0, 0, 29)
    Hit.Size = UDim2.new(1, 0, 0, 29)
    Hit.BorderSizePixel = 0
    Hit.ZIndex = 3

    local function lockDrag()
        locked = true
        scroller = Frame:FindFirstAncestorWhichIsA("ScrollingFrame")
        if scroller then scroller.ScrollingEnabled = false end
        TweenService:Create(Knob, TweenInfo.new(0.15), {Size = UDim2.new(0, 19, 0, 19)}):Play()
    end

    local function endDrag()
        local wasTap = dragging and not locked and not cancelled and startPos ~= nil
        local tapX = startPos and startPos.X
        dragging = false
        locked = false
        cancelled = false
        activeInput = nil
        startPos = nil
        if scroller then
            scroller.ScrollingEnabled = true
            scroller = nil
        end
        TweenService:Create(Knob, TweenInfo.new(0.15), {Size = UDim2.new(0, 16, 0, 16)}):Play()
        if wasTap and tapX then updateFromX(tapX) end
    end

    Hit.InputBegan:Connect(function(input)
        if dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            cancelled = false
            activeInput = input
            startPos = input.Position
            lockDrag()
            updateFromX(input.Position.X)
        elseif input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            cancelled = false
            locked = false
            activeInput = input
            startPos = input.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging or cancelled then return end
        if input.UserInputType == Enum.UserInputType.Touch then
            if input ~= activeInput then return end
            if not locked then
                local dx = input.Position.X - startPos.X
                local dy = input.Position.Y - startPos.Y
                if math.abs(dy) > THRESH and math.abs(dy) > math.abs(dx) then
                    cancelled = true
                    return
                elseif math.abs(dx) > THRESH then
                    lockDrag()
                end
            end
            if locked then updateFromX(input.Position.X) end
        elseif input.UserInputType == Enum.UserInputType.MouseMovement then
            if locked then updateFromX(input.Position.X) end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or (input.UserInputType == Enum.UserInputType.Touch and input == activeInput) then
            endDrag()
        end
    end)

    local function setValue(v)
        v = math.clamp(math.floor(v + 0.5), minVal, maxVal)
        current = v
        local rel = (v - minVal) / (maxVal - minVal)
        Fill.Size = UDim2.new(rel, 0, 1, 0)
        Knob.Position = UDim2.new(rel, 0, 0.5, 0)
        ValBox.Text = tostring(v) .. suffix
        if callback then
            local ok, err = pcall(callback, v)
            if not ok then warn("Zirth Hub: " .. name .. " - " .. tostring(err)) end
        end
    end

    ValBox.FocusLost:Connect(function()
        local typed = tonumber((ValBox.Text:match("%-?%d+%.?%d*")))
        if typed then
            setValue(typed)
        else
            ValBox.Text = tostring(current) .. suffix
        end
    end)

    local sliderId = (name:gsub("%s+", "_")):lower()
    SliderRegistry[sliderId] = {
        name = name,
        default = defaultVal,
        getValue = function() return current end,
        setValue = setValue,
    }

    table.insert(SearchItems, {name = name, obj = Frame})

    return Frame
end

