local function dismissToast(slot)
    if not slot or not slot.Parent then return end
    for i, v in ipairs(activeToasts) do
        if v == slot then
            table.remove(activeToasts, i)
            break
        end
    end
    local toast = slot:FindFirstChild("Toast")
    if toast then
        TweenService:Create(toast, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 20, 0, 0)
        }):Play()
    end
    task.delay(0.22, function()
        if slot and slot.Parent then slot:Destroy() end
    end)
end

