local CODE_PREFIX = "ZH1:"

CreateButton(ConfigTransfer, "Create Config Code", function()
    local data
    if codeSource then
        local content
        if readfile then
            local ok, res = pcall(readfile, getConfigPath(codeSource))
            if ok then content = res end
        end
        if content then
            local ok, res = pcall(function() return HttpService:JSONDecode(content) end)
            if ok then data = res end
        else
            data = Z.ZirthHubConfigs and Z.ZirthHubConfigs[codeSource]
        end
        if type(data) ~= "table" then error("Config not found", 0) end
    else
        data = collectCurrentState()
    end
    local ok, json = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok then error("Encode error", 0) end
    local code = CODE_PREFIX .. Codec.encode(json)
    CodeInput.Text = code
    local clip = setclipboard or toclipboard
    if clip then
        pcall(clip, code)
        ShowToast("Config Code", "Created and copied")
    else
        ShowToast("Config Code", "Created")
    end
end, true)

CreateButton(ConfigTransfer, "Load Config Code", function()
    local code = CodeInput.Text:gsub("%s+", "")
    if code:sub(1, #CODE_PREFIX) ~= CODE_PREFIX then
        ShowToast("Load Failed", "Invalid config code")
        return
    end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(Codec.decode(code:sub(#CODE_PREFIX + 1)))
    end)
    if not ok or type(data) ~= "table" then
        ShowToast("Load Failed", "Invalid config code")
        return
    end
    local count = applyConfigData(data)
    ShowToast("Config Code Loaded", count .. " settings applied")
end, true)

