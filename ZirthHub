local function KINON_TryParry(reason, killerRoot, fast)
	if unloaded or not (Parry.Enabled or ParryV2.Enabled) then return false end
	local closeNow, veryClose, pointBlank = false, false, false
	if killerRoot then
		local myRoot = getRoot()
		if myRoot then
			local d = (killerRoot.Position - myRoot.Position).Magnitude
			closeNow = d <= 6
			veryClose = d <= 3
			pointBlank = d <= 5
		end
	end
	if (Parry.Enabled and Parry.AggressiveMode) or (ParryV2.Enabled and ParryV2.AggressiveMode) then fast = true end
	if not fast and tick() - KINON_ParryEngine.LastAttempt < 0.002 then return false end
	local parryTool = KINON_GetParryTool()
	if not parryTool then return KINON_ParryDeny("parry dagger tidak ditemukan") end
	local character = LP.Character
	if character and typeof(parryTool) == "Instance" and parryTool:IsA("Tool") and parryTool.Parent ~= character then
		local holdingOther = false
		for _, c in ipairs(character:GetChildren()) do
			if c:IsA("Tool") and c ~= parryTool then holdingOther = true break end
		end
		local hum = character:FindFirstChildOfClass("Humanoid")
		if hum and not holdingOther then
			KINON_ParryEngine.LastEquip = tick()
			pcall(function() hum:EquipTool(parryTool) end)
		end
	end
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not humanoid or humanoid.Health <= 0 then return false end
	if not KINON_IsSafeToParry(character) then return KINON_ParryDeny("Safety Parry") end
	if character:GetAttribute("Knocked") == true or LP:GetAttribute("Knocked") == true
		or character:GetAttribute("IsHooked") == true or LP:GetAttribute("IsHooked") == true
		or character:GetAttribute("IsCarried") == true or LP:GetAttribute("IsCarried") == true
		or character:GetAttribute("IsDead") == true or LP:GetAttribute("IsDead") == true then
		return false
	end

	local client = KINON_FindParryClient(true)
	if client and client.isParryOnCooldown then
		local now = tick()
		local E0 = KINON_ParryEngine
		-- jeda panjang antar pengecekan = cooldown baru, bukan macet
		if E0.LastCooldownSeen and now - E0.LastCooldownSeen > 1 then E0.CooldownStuckSince = nil end
		E0.LastCooldownSeen = now
		KINON_ParryEngine.CooldownStuckSince = KINON_ParryEngine.CooldownStuckSince or now
		if now - KINON_ParryEngine.CooldownStuckSince > 8 then
			KINON_ParryEngine.CooldownStuckSince = now
			pcall(function()
				if type(client._bindCharacter) == "function" and character then
					client:_bindCharacter(character)
				end
			end)
		end
		return KINON_ParryDeny("parry cooldown")
	else
		KINON_ParryEngine.CooldownStuckSince = nil
	end
	if tick() < (KINON_ParryEngine.CDUntil or 0) then return KINON_ParryDeny("cooldown (timer sendiri)") end
	if client and client.isParryResolving then return KINON_ParryDeny("parry sedang resolving") end

	if client and type(client.CanUse) == "function" then
		local okUse, canUse = pcall(client.CanUse, client)
		if okUse and canUse == false then return KINON_ParryDeny("dagger belum siap (CanUse=false)") end
	end

	if tick() - (KINON_ParryEngine.LastSuccess or 0) < (pointBlank and 0.03 or 0.1) then return false end

	KINON_ParryEngine.LastAttempt = tick()

	if client then
		local ok, result = pcall(function()
			if client.character ~= character and type(client._bindCharacter) == "function" then
				pcall(function() client:_bindCharacter(character) end)
			end
			return client:Parry()
		end)
		if ok and result ~= false then
			KINON_ParryEngine.LastSuccess = tick()
			KINON_ParryEngine.CDUntil = tick() + (KINON_ParryEngine.FlagWorks and 0.3 or KINON_ParryEngine.GetCD(client))
			return true
		end
		return false
	end

	local fallbackOk, fallbackFired = pcall(KINON_TryFallbackParry)
	if fallbackOk and fallbackFired then
		KINON_ParryEngine.LastSuccess = tick()
		KINON_ParryEngine.CDUntil = tick() + KINON_ParryEngine.GetCD(nil)
		return true
	end
	return false
end

local function KINON_InRangeAndFacing(killerRoot, playerRoot, positionOverride, isLunge, isOptional)
	if not killerRoot or not playerRoot then return false end
	local distance = ((positionOverride or killerRoot.Position) - playerRoot.Position).Magnitude
	local range = math.clamp(tonumber(Parry.Range) or 14, 5, 35)
		+ math.clamp(tonumber(Parry.ReachBonus) or 0, 0, 10)
	if distance > range then return false end
	if not KINON_ShouldPassFaceCheck(killerRoot, playerRoot) then return false end
	return true
end

