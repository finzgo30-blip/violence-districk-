		if method == 1 and UserInputService.TouchEnabled and usable then
			local x, y = self:_buttonCenter(btn)
			local began = pcall(function() VirtualInputManager:SendTouchEvent(8822, 0, x, y) end)
			task.wait(hold)
			pcall(function() VirtualInputManager:SendTouchEvent(8822, 2, x, y) end)
