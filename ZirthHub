	function Class:_inAngleRange(lineRot, goalRot, minOff, maxOff)
		local minA = (goalRot + minOff) % 360
		local maxA = (goalRot + maxOff) % 360
		if maxA < minA then
			return minA <= lineRot or lineRot <= maxA
		end
		return minA <= lineRot and lineRot <= maxA
	end

	function Class:_shouldFireByRange(lineRot, goalRot)
		local S = self.Settings
		local m = self._effMode or S.Mode
		if m == "Normal" then
			return self:_inAngleRange(lineRot, goalRot, S.NormalMinOffset, S.NormalMaxOffset)
		end
		return self:_inAngleRange(lineRot, goalRot, S.LegitMinOffset, S.LegitMaxOffset)
	end

	function Class:_onHeartbeat()
		if not self.Settings.Enabled or self._busy then return end

		local scGui
		for _, guiName in ipairs({ "SkillCheckPromptGui", "SkillCheckPromptGui-con" }) do
			local candidate = PlayerGui:FindFirstChild(guiName)
			if candidate and candidate.Enabled ~= false then
				local c = candidate:FindFirstChild("Check")
				if c and c.Visible then scGui = candidate; break end
			end
		end
		if not scGui then return end

		local check = scGui:FindFirstChild("Check")
		if not check or not check.Visible then return end
		local line = check:FindFirstChild("Line")
		if not line then return end

		local mode = self.Settings.Mode
		self._effMode = nil
		if mode == "Instant" then
			local prog = nearestGeneratorProgress()
			if prog and prog >= 90 then
				mode = "Normal"
				self._effMode = "Normal"
			end
		end
		local goal = check:FindFirstChild("Goal")
		local trap = check:FindFirstChild("TrapPerfect") or check:FindFirstChild("TrapGoal")
		local trapChar = LP.Character
		if (trap and trap.Visible) or (trapChar and (trapChar:GetAttribute("Trapped") == true or trapChar:GetAttribute("EscapingTrap") == true)) then return end

		if mode == "Instant" then

			local trapPerfect = check:FindFirstChild("TrapPerfect")
			local isTrapPerfect = trapPerfect and trapPerfect.Visible
			local target = isTrapPerfect and trapPerfect or (trap and trap.Visible and trap) or (goal and goal.Visible and goal)
			if not target then return end

			if self._instantPromptAt == nil or self._instantPromptTarget ~= target then
				self._instantPromptAt = os.clock()
				self._instantPromptTarget = target
			end

			local minWait = math.clamp(0.12 + getPingSeconds() * 0.6, 0.14, 0.28)
			if os.clock() - self._instantPromptAt < minWait then return end

			self._busy = true
			local targetRot = isTrapPerfect and (target.Rotation % 360) or ((target.Rotation + self.Settings.InstantOffset) % 360)
			ActiveLine, ActiveTargetRot = line, targetRot
			line.Rotation = targetRot
			task.spawn(function()
				local fired = false
				local lockActive = true

				local lockConn = RunService.RenderStepped:Connect(function()
					if lockActive and line and line.Parent then
						line.Rotation = targetRot
					end
				end)
				local ok = pcall(function()
					for _ = 1, 2 do
						line.Rotation = targetRot
						RunService.Heartbeat:Wait()
					end
					fired = self:_fireActionV91()
				end)
				task.wait(0.10)
				lockActive = false
				if lockConn then lockConn:Disconnect() end
				task.wait(0.15)
				if ActiveLine == line then ActiveLine, ActiveTargetRot = nil, nil end
				self._instantPromptAt, self._instantPromptTarget = nil, nil
				if fired and ok then
					self.Stats.Hits = self.Stats.Hits + 1
				else
					self.Stats.Missed = self.Stats.Missed + 1
				end
				task.wait(math.max(0.12, self.Settings.BusyResetDelay))
				self._busy = false
			end)
			return
		end

		if not goal then return end
		if (check:FindFirstChild("TrapPerfect") and check.TrapPerfect.Visible)
			or (check:FindFirstChild("TrapGoal") and check.TrapGoal.Visible) then return end
		if not self:_shouldFireByRange(line.Rotation % 360, goal.Rotation % 360) then return end

		self._busy = true
		task.spawn(function()
			local ok = self:_fireActionV91()
			if ok then
				self.Stats.Hits = self.Stats.Hits + 1
			else
				self.Stats.Missed = self.Stats.Missed + 1
			end
			task.wait(self.Settings.BusyResetDelay)
			self._busy = false
		end)
	end

	function Class:_hookKingScourge()
		task.spawn(function()
			pcall(function()
				local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
				if not remotes then return end
				local perks = remotes:WaitForChild("KillerPerks", 5)
				if not perks then return end
