    local function goToItem(item)
        local obj = item.obj
        if not obj or not obj.Parent then return end
        local tabData, slide = tabOf(obj)
        if tabData then tabData.Select() end
        local sectionFrame
        local p = obj.Parent
        while p and p ~= slide do
            if SectionControl[p] then
                SectionControl[p](true)
                if not sectionFrame then sectionFrame = p.Parent end
            end
            p = p.Parent
        end
        task.delay(0.12, function()
