	if stunAttr(model) then return true end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if stunAttr(humanoid) or stunAttr(model:FindFirstChild("CheckInterractable")) then return true end
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if animator then
