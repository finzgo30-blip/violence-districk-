local function KINON_ParryInRange(killerRoot, playerRoot, vel, isLunge, isOptional)

	local lead = 0.18
	pcall(function() lead = math.clamp(LP:GetNetworkPing() + 0.09, 0.12, 0.35) end)
	local predicted
	if vel and typeof(vel) == "Vector3" and vel.Magnitude > 4 then
		local toMe = playerRoot.Position - killerRoot.Position
		if toMe.Magnitude > 0.001 and vel:Dot(toMe.Unit) > 2 then
			predicted = killerRoot.Position + vel * lead
		end
	end
	if Parry.Enabled then
		if KINON_InRangeAndFacing(killerRoot, playerRoot, nil, isLunge, isOptional) then return true end
		if predicted and isLunge and KINON_InRangeAndFacing(killerRoot, playerRoot, predicted, isLunge, isOptional) then return true end
		return false
	end
	local ok, res = pcall(KINON_InRangeAndFacingV2, killerRoot, playerRoot, nil, vel, isLunge, isOptional)
	if ok and res == true then return true end
	if ok and predicted and isLunge then
		local ok2, res2 = pcall(KINON_InRangeAndFacingV2, killerRoot, playerRoot, predicted, vel, isLunge, isOptional)
		if ok2 and res2 == true then return true end
	end
	if ok then return false end
	local d = (killerRoot.Position - playerRoot.Position).Magnitude
	return d <= (tonumber(ParryV2.Range) or 14) + (tonumber(ParryV2.ReachBonus) or 0)
end

