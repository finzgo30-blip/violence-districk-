                        local tUsed = tTrue / math.max(sh.mult or 1, 0.2)
                        local kTrue = (tUsed - (sh.base or 0)) / travel
                        local k = tonumber(VD.TOF_TravelK) or 0.5
                        VD.TOF_TravelK = math.clamp(k + (math.clamp(kTrue, 0, 2.5) - k) * 0.25, 0, 2.5)
