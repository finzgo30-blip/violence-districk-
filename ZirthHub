local function KINON_ShouldPassFaceCheck(killerRoot, playerRoot)
	if Z.AntiFakeHit or Parry.AggressiveMode then
		return true
	end
	if not killerRoot or not playerRoot then
		return false
	end
	-- cek sederhana: apakah killer sedang menghadap kita
	local offset = playerRoot.Position - killerRoot.Position
	offset = Vector3.new(offset.X, 0, offset.Z)
	local look = killerRoot.CFrame.LookVector
	look = Vector3.new(look.X, 0, look.Z)
	if offset.Magnitude < 0.05 or look.Magnitude < 0.05 then return true end
	local sensitivity = math.clamp(tonumber(Parry.FaceSensitivity) or 10, 0, 10) / 10
	local maxAngle = 20 + sensitivity * 100
	-- killer dekat sedang memutar badan saat mengayun: sudut dilonggarkan supaya tidak telat
	local dist = offset.Magnitude
	if dist <= 2.5 then return true end
	if dist <= 7 then maxAngle = math.min(maxAngle + 45, 160) end
	return look.Unit:Dot(offset.Unit) >= math.cos(math.rad(maxAngle))
end

