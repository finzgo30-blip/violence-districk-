        local center = camera.ViewportSize / 2
        local myChar = LP.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return list end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character and plr.Character ~= myChar then
                local char = plr.Character
                if not isKillerTeam(char) then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hum and hum.Health > 0 and hrp
                        and not char:GetAttribute("Immobile")
                        and not char:GetAttribute("IsHooked")
                        and not char:GetAttribute("Knocked") then
                        local dist = (hrp.Position - myHRP.Position).Magnitude
                        if dist <= math.min(V.MaxRange, 320) then
                            local s, onScreen = camera:WorldToViewportPoint(hrp.Position)
                            if onScreen and s.Z > 0 then
                                local px = (Vector2.new(s.X, s.Y) - center).Magnitude
                                if (not V.FovAim) or px <= V.FOV then
                                    table.insert(list, { char = char, hrp = hrp, hum = hum, px = px, dist = dist })
                                end
                            end
                        end
                    end
                end
            end
        end
        return list
    end

    local function pick(list)
        if #list == 0 then return nil end
        table.sort(list, function(a, b) return a.px < b.px end)
        local cur = V.TargetChar
        if cur then
            for _, c in ipairs(list) do
                if c.char == cur then
                    if c.px <= list[1].px + 18 then return c end
                    break
                end
            end
        end
        return list[1]
    end

    -- target motion tracking
    local tracker = { char = nil, samples = {} }
    local function trackTarget(char, hrp)
        local now = os.clock()
        if tracker.char ~= char then tracker.char, tracker.samples = char, {} end
        local smp = tracker.samples
        smp[#smp + 1] = { t = now, p = hrp.Position }
        while #smp > 2 and now - smp[1].t > 0.9 do table.remove(smp, 1) end
    end

    local function windowVelocity(smp, window)
        local last, first = smp[#smp], smp[1]
        for i = #smp, 1, -1 do
            if last.t - smp[i].t >= window then first = smp[i]; break end
        end
        local dt = last.t - first.t
        if dt < 0.03 then return nil end
        return (last.p - first.p) / dt
    end

    local function regress(list, tn, window, tau)
        local sw, sdt, sdt2, n = 0, 0, 0, 0
        local sp, sdtp = Vector3.zero, Vector3.zero
        for i = #list, 1, -1 do
            local e = list[i]
            local dt = e.t - tn
            if dt < -window then break end
            local w = math.exp(dt / tau)
            sw = sw + w; sdt = sdt + w * dt; sdt2 = sdt2 + w * dt * dt
            sp = sp + e.p * w; sdtp = sdtp + e.p * (w * dt)
            n = n + 1
        end
        if n < 3 then return nil end
        local denom = sw * sdt2 - sdt * sdt
        if denom < 1e-9 then return nil end
        return (sdtp * sw - sp * sdt) / denom
    end

    local INTERACT_ATTR = { "repair", "generator", "heal", "unhook", "rescu", "gate", "interact", "opening", "working", "search", "chest", "sabotage", "cleanse", "totem", "pickup" }
    local INTERACT_ANIM = { "repair", "generator", "heal", "unhook", "rescue", "gate", "search", "chest", "sabotage", "cleanse", "totem", "pickup" }

    local function isInteracting(char)
        local okA, attrs = pcall(function() return char:GetAttributes() end)
        if okA and type(attrs) == "table" then
            for name, value in pairs(attrs) do
                if value == true then
                    local n = string.lower(tostring(name))
                    if not (n:find("^can") or n:find("^has") or n:find("^allow")) then
                        for _, key in ipairs(INTERACT_ATTR) do
                            if n:find(key, 1, true) then return true end
                        end
                    end
                end
            end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if animator then
            local okT, tracks = pcall(function() return animator:GetPlayingAnimationTracks() end)
            if okT and tracks then
                for _, tr in ipairs(tracks) do
                    local label = ""
                    pcall(function()
                        label = string.lower(tostring(tr.Name) .. " " .. tostring(tr.Animation and tr.Animation.Name or ""))
                    end)
                    if label ~= "" then
                        for _, key in ipairs(INTERACT_ANIM) do
                            if label:find(key, 1, true) then return true end
                        end
                    end
                end
            end
        end
        return false
    end

    local function stationaryByHistory(char)
        local smp = tracker.samples
        if tracker.char ~= char or #smp < 6 then return false end
        local last, first = smp[#smp], nil
        for i = #smp, 1, -1 do
            if last.t - smp[i].t >= 0.5 then first = smp[i]; break end
        end
        if not first then return false end
        local d = last.p - first.p
        return Vector3.new(d.X, 0, d.Z).Magnitude < 0.9
    end

    local function estimateVelocity(char, hrp)
        if isInteracting(char) or stationaryByHistory(char) then return Vector3.zero end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local live = hrp.AssemblyLinearVelocity or Vector3.zero
        local liveY = math.clamp(live.Y, -BAL.YVelClamp, BAL.YVelClamp)
        local liveFlat = Vector3.new(live.X, 0, live.Z)
        if not hum then
            if liveFlat.Magnitude < 2.5 then return Vector3.new(0, liveY, 0) end
            if liveFlat.Magnitude > BAL.VelMagCap then liveFlat = liveFlat.Unit * BAL.VelMagCap end
            return Vector3.new(liveFlat.X, liveY, liveFlat.Z)
        end
        local move = hum.MoveDirection
        local moveFlat = Vector3.new(move.X, 0, move.Z)
        local desired
        local fitV
        local smpF = tracker.samples
        if tracker.char == char and #smpF >= 5 then fitV = regress(smpF, smpF[#smpF].t, 0.18, 0.08) end
        local fitFlat = fitV and Vector3.new(fitV.X, 0, fitV.Z) or nil
        if moveFlat.Magnitude >= 0.05 then
            local walkSpeed = math.max(0, tonumber(hum.WalkSpeed) or 16)
            local speedNow = walkSpeed
            if fitFlat then
                local along = fitFlat:Dot(moveFlat.Unit)
                if along > 1.5 then speedNow = math.clamp(along * 1.1, walkSpeed * 0.5, walkSpeed)
                elseif along < -1 then speedNow = walkSpeed * 0.8
                elseif fitFlat.Magnitude < 1.5 then speedNow = walkSpeed * 0.5 end
            end
            desired = moveFlat.Unit * speedNow
        else
            if fitFlat and fitFlat.Magnitude < 2.5 then return Vector3.new(0, liveY, 0) end
            if liveFlat.Magnitude < 2.5 then return Vector3.new(0, liveY, 0) end
            local smp = tracker.samples
            local hist = tracker.char == char and #smp >= 4 and windowVelocity(smp, 0.14) or nil
            local histFlat = hist and Vector3.new(hist.X, 0, hist.Z) or nil
            if histFlat and histFlat.Magnitude < 2.5 then return Vector3.new(0, liveY, 0) end
            if histFlat and histFlat.Magnitude > 1 and histFlat.Unit:Dot(liveFlat.Unit) < 0.45 then
                return Vector3.new(0, liveY, 0)
            end
            desired = histFlat and histFlat.Magnitude > 1 and histFlat or liveFlat
        end
        if desired.Magnitude > BAL.VelMagCap then desired = desired.Unit * BAL.VelMagCap end
        return Vector3.new(desired.X, liveY, desired.Z)
    end

    local function solveThrow(targetChar, origin, chargeTime)
        local hrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local dist = (hrp.Position - origin).Magnitude
        local farFactor = math.clamp((dist - 45) / 35, 0, 1)
        local baseSpeed = math.clamp(tonumber(V.SpearSpeed) or 180, 60, 180)
        local speed = baseSpeed + (math.min(150, baseSpeed) - baseSpeed) * farFactor
        local launchSpeed = math.clamp((chargeTime or BAL.FullChargeTime) * speed, 1, speed)
        local gVec = getGravity()
        local gMag = math.abs(gVec.Y)
        local farLead = math.clamp((dist - 40) / 120, 0, 1)
        local latency = getPingHalf() + 0.03 + 0.06 * math.clamp((dist - 40) / 160, 0, 1)
        local leadMul = 1.4 - 0.55 * farLead
        local aimPoint = hrp.Position + Vector3.new(0, 0.2, 0)
        if V.AimPart ~= "HumanoidRootPart" and dist > 100 then
            local head = targetChar:FindFirstChild("Head")
            if head and head:IsA("BasePart") then aimPoint = head.Position end
        end
        local vel = clampVelY(estimateVelocity(targetChar, hrp))
        if V.Predict == false then vel = Vector3.zero
        else vel = vel * math.clamp(tonumber(V.PredStrength) or 1, 0, 1.5) end
        local maxLead = math.clamp(dist * (0.6 - 0.25 * farLead), 3, 45 - 17 * farLead)
        local function leadOffset(tt)
            local off = vel * ((tt + latency) * leadMul)
            if off.Magnitude > maxLead then off = off.Unit * maxLead end
            return off
        end

        local rel = aimPoint + leadOffset(0.3) - origin
        local t = math.max(0.04, rel.Magnitude / launchSpeed)
        local ballisticOK = true
        for _ = 1, 8 do
            local toTarget = aimPoint + leadOffset(t) - origin
            local hMag = Vector3.new(toTarget.X, 0, toTarget.Z).Magnitude
            local yOff = toTarget.Y
            local a = 0.25 * gMag * gMag
            local b = yOff * gMag - launchSpeed * launchSpeed
            local c = hMag * hMag + yOff * yOff
            local disc = b * b - 4 * a * c
            if gMag < 0.001 then
                t = math.max(0.04, toTarget.Magnitude / launchSpeed)
            elseif disc >= 0 then
                local r = (-b - math.sqrt(disc)) / (2 * a)
                if r > 0 then t = math.sqrt(r) else t = math.max(0.04, toTarget.Magnitude / launchSpeed) end
            else
                ballisticOK = false
                t = math.max(0.04, toTarget.Magnitude / launchSpeed)
                break
            end
        end
        local finalAim = aimPoint + leadOffset(t)
        local finalRel = finalAim - origin
        if not ballisticOK and gMag > 0.001 then
            local flat = Vector3.new(finalRel.X, 0, finalRel.Z)
            local flatDir = flat.Magnitude > 0.001 and flat.Unit or Vector3.new(0, 0, -1)
            local num = launchSpeed * launchSpeed - 2 * gMag * finalRel.Y
            local angle = num > 0 and math.atan(launchSpeed / math.sqrt(num)) or math.rad(45)
            local dir = (flatDir * math.cos(angle) + Vector3.new(0, math.sin(angle), 0)).Unit
            return dir, dir * launchSpeed, launchSpeed, finalAim
        end
        local dirVec = (finalRel - 0.5 * gVec * t * t) / t
        return dirVec.Unit, dirVec, launchSpeed, finalAim
    end

    local function isSpearActive(char)
        if not char then return false end
        local morph = char:GetAttribute("MorphedKiller")
        if morph == "Veil" or char:GetAttribute("Veil") == true then return true end
        if char:GetAttribute("spearmode") == true then return true end
        if char:GetAttribute("VeilSpearEquipped") == true then return true end
        local spear = char:FindFirstChild("Spear")
        if spear then
            local inner = spear:FindFirstChild("Spear")
            if inner and inner:IsA("BasePart") then return inner.Transparency < 0.5 end
            return true
        end
        return false
    end

    -- charge time (needs getgc; falls back to full charge)
    local endAttackCache, endAttackAnims, endAttackSearched = nil, nil, false
    local function ensureChargeFn()
        local char = LP.Character
        local anims = char and char:FindFirstChild("Animations")
        if not anims then return end
        if type(getgc) ~= "function" or type(getupvalues) ~= "function" then return end
        if endAttackAnims ~= anims then endAttackAnims, endAttackCache, endAttackSearched = anims, nil, false end
        if endAttackCache or endAttackSearched then return end
        endAttackSearched = true
        pcall(function()
            for _, fn in ipairs(getgc()) do
                if type(fn) == "function" and (not islclosure or islclosure(fn)) then
                    if debug.info(fn, "n") == "endAttack" and getfenv(fn).script == anims then
                        endAttackCache = fn
                        break
                    end
                end
            end
        end)
    end
    local function getChargeTime()
        if not endAttackCache then return BAL.FullChargeTime end
        local ok, ups = pcall(getupvalues, endAttackCache)
        if ok and ups then
            local isThrown = ups[2] == true
            local startTime = tonumber(ups[9]) or 0
            if isThrown and startTime > 0 then
                return math.max(BAL.MinChargeTime, workspace:GetServerTimeNow() - startTime)
            end
        end
        return BAL.FullChargeTime
    end

    local viewDelayFn = nil
    task.spawn(function()
        for _ = 1, 40 do
            if unloaded or V.Dead or viewDelayFn then return end
            pcall(function()
                local mods = ReplicatedStorage:FindFirstChild("Modules")
                local world = mods and mods:FindFirstChild("World")
                local vis = world and world:FindFirstChild("ProjectileVisualsClient")
                if vis and vis:IsA("ModuleScript") then
                    local m = require(vis)
                    if m and type(m.viewDelay) == "function" then viewDelayFn = m.viewDelay end
                end
            end)
            task.wait(0.25)
        end
    end)
    task.spawn(function()
        while not unloaded and not V.Dead do
            if V.Enabled then pcall(ensureChargeFn) end
            task.wait(0.5)
        end
    end)

    -- ===== SPEAR LINE: a Trail glued to the spear itself (real projectile if found, else a tracker flying the same arc) =====
    local TRAIL_LIFE = 0.9
    local function partOf(obj)
        if obj:IsA("BasePart") then return obj end
        if obj:IsA("Model") then return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true) end
        return nil
    end

    local function looksLikeSpear(obj)
        local n = string.lower(obj.Name)
        if not (n:find("spear", 1, true) or n:find("javelin", 1, true) or n:find("projectile", 1, true)) then return false end
        if obj:FindFirstAncestorOfClass("Model") and Players:GetPlayerFromCharacter(obj:FindFirstAncestorOfClass("Model")) then return false end
        local o = obj
        while o and o ~= workspace do
            if o:IsA("Model") and Players:GetPlayerFromCharacter(o) then return false end
            o = o.Parent
        end
        return true
    end

    local function makeTrail(part)
        local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
        a0.Name, a1.Name = "ZSpearA0", "ZSpearA1"
        a0.Parent, a1.Parent = part, part
        local trail = Instance.new("Trail")
        trail.Name = "ZirthSpearTrail"
        trail.Attachment0, trail.Attachment1 = a0, a1
        trail.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
        trail.LightEmission = 1
        trail.LightInfluence = 0
        trail.FaceCamera = true
        trail.Lifetime = TRAIL_LIFE
        trail.MinLength = 0.02
        trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(1, 1) })
        trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
        trail.Parent = part
        return a0, a1, trail
    end

    -- keep the trail ~constant on screen regardless of distance
    local function keepWidth(a0, a1, part)
        local cam = workspace.CurrentCamera
        local k = cam and math.clamp((part.Position - cam.CFrame.Position).Magnitude / 22, 1, 8) or 1
        local h = 0.11 * k
        a0.Position = Vector3.new(0, h, 0)
        a1.Position = Vector3.new(0, -h, 0)
    end

    local function followReal(part)
        local a0, a1, trail = makeTrail(part)
        task.spawn(function()
            while part.Parent and not unloaded and not V.Dead do
                keepWidth(a0, a1, part)
                RunService.Heartbeat:Wait()
            end
            -- the spear is gone: leave the last bit of trail to fade
            pcall(function()
                trail.Enabled = false
                task.wait(TRAIL_LIFE)
                a0:Destroy(); a1:Destroy(); trail:Destroy()
            end)
        end)
    end

    local function followSynthetic(origin, dir, speed, ctl)
        task.spawn(function()
            local gravity = getGravity()
            local v0 = dir.Unit * speed
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.RespectCanCollide = true
            local ignore = {}
            if LP.Character then table.insert(ignore, LP.Character) end
            params.FilterDescendantsInstances = ignore

            local tracker2 = Instance.new("Part")
            tracker2.Name = "ZirthSpearTracker"
            tracker2.Anchored, tracker2.CanCollide, tracker2.CanQuery, tracker2.CanTouch = true, false, false, false
            tracker2.Transparency = 1
            tracker2.Size = Vector3.new(0.2, 0.2, 0.2)
            tracker2.CFrame = CFrame.new(origin)
            tracker2.Parent = workspace
            local a0, a1, trail = makeTrail(tracker2)

            local start, prev = os.clock(), origin
            while not unloaded and not V.Dead and not ctl.stop do
                local tt = os.clock() - start
                if tt > 6 then break end
                local nxt = origin + v0 * tt + 0.5 * gravity * tt * tt
                local delta = nxt - prev
                local stop = false
                if delta.Magnitude > 0.01 then
                    for _ = 1, 4 do
                        local hit = workspace:Raycast(prev, delta, params)
                        if hit and hit.Instance and not hit.Instance:IsA("Terrain") and hit.Instance.Transparency >= 0.99 then
                            ignore[#ignore + 1] = hit.Instance
                            params.FilterDescendantsInstances = ignore
                        else
                            if hit then nxt = hit.Position; stop = true end
                            break
                        end
                    end
                end
                tracker2.CFrame = CFrame.new(nxt)
                keepWidth(a0, a1, tracker2)
                prev = nxt
                if stop then break end
                RunService.Heartbeat:Wait()
            end
            if ctl.stop then
                pcall(function() tracker2:Destroy() end)  -- replaced by the real spear's own trail
                return
            end
            trail.Enabled = false
            task.wait(TRAIL_LIFE)
            pcall(function() tracker2:Destroy() end)
        end)
    end

    -- called right before the throw is sent, so the line is there on the very first frame
    local function showSpearLine(origin, dir, speed)
        if typeof(origin) ~= "Vector3" or typeof(dir) ~= "Vector3" or dir.Magnitude < 0.01 then return end
        speed = tonumber(speed) or 180
        local ctl = { stop = false }
        local found
        local conn
        conn = workspace.DescendantAdded:Connect(function(obj)
            if found then return end
            if looksLikeSpear(obj) then
                local p = partOf(obj)
                if p and (p.Position - origin).Magnitude < 25 then found = p end
            end
        end)
        followSynthetic(origin, dir, speed, ctl)
        task.spawn(function()
            local t0 = os.clock()
            while not found and os.clock() - t0 < 0.25 do RunService.Heartbeat:Wait() end
            conn:Disconnect()
            if found and found.Parent then
                ctl.stop = true
                followReal(found)
            end
        end)
    end

    local function applyPayload(payload, origin, dir, speed)
        payload.Origin = origin
        payload.Direction = dir
        if payload.Velocity ~= nil then payload.Velocity = dir * speed end
        if viewDelayFn then pcall(function() payload.ViewDelay = viewDelayFn(origin, dir) end) end
    end

    V.NamecallHandler = function(old, self, ...)
        local method = getnamecallmethod()
        if not V.Enabled or (method ~= "FireServer" and method ~= "fireServer") then
            if setnamecallmethod and method then setnamecallmethod(method) end
            return old(self, ...)
        end
        local isSpear = false
        pcall(function() isSpear = typeof(self) == "Instance" and string.lower(self.Name) == "spearthrow" end)
        if not isSpear or (checkcaller and checkcaller()) then
            if setnamecallmethod then pcall(setnamecallmethod, method) end
            return old(self, ...)
        end

        local args = table.pack(...)
        local trailOrigin, trailDir, trailSpeed

        pcall(function()
            local char = LP.Character
            if not char or not isSpearActive(char) then return end
            local camera = workspace.CurrentCamera
            if not camera then return end
            local payload = type(args[1]) == "table" and args[1] or nil

            local origin
            if payload and typeof(payload.Origin) == "Vector3" then
                origin = payload.Origin
            elseif typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
                origin = args[1]
            elseif typeof(args[1]) == "Vector3" and type(args[2]) == "number" and typeof(args[3]) == "Vector3" then
                origin = args[3]
            else
                origin = camera.CFrame.Position + camera.CFrame.LookVector * BAL.SpawnOffset
            end

            local speedForm = payload == nil and typeof(args[1]) == "Vector3" and type(args[2]) == "number"
            local charge = speedForm and BAL.FullChargeTime or getChargeTime()
            local target = V.TargetChar
            local redirected = false

            if target and target.Parent then
                local dir, _, speed = solveThrow(target, origin, charge)
                if dir then
                    trailOrigin, trailDir, trailSpeed = origin, dir, speed
                    if payload then
                        local ok = pcall(applyPayload, payload, origin, dir, speed)
                        if ok then redirected = true
                        else
                            local clone = table.clone and table.clone(payload) or nil
                            if clone and pcall(applyPayload, clone, origin, dir, speed) then
                                args[1] = clone
                                redirected = true
                            end
                        end
                    elseif typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
                        args[1], args[2] = origin, dir
                        redirected = true
                    elseif speedForm then
                        args[1], args[2] = dir, speed
                        redirected = true
                    elseif typeof(args[1]) == "Vector3" then
                        args[1] = dir
                        redirected = true
                    end
                end
            end

            if not redirected then
                trailOrigin, trailDir, trailSpeed = nil, nil, nil
                if payload and typeof(payload.Direction) == "Vector3" then
                    trailOrigin = origin
                    trailDir = payload.Direction
                    trailSpeed = typeof(payload.Velocity) == "Vector3" and payload.Velocity.Magnitude
                        or math.clamp(charge * (tonumber(V.SpearSpeed) or 180), 1, 200)
                elseif typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
                    trailOrigin, trailDir = args[1], args[2]
                    trailSpeed = math.clamp(charge * (tonumber(V.SpearSpeed) or 180), 1, 200)
                end
            end
        end)

        if setnamecallmethod then pcall(setnamecallmethod, method) end
        if trailOrigin then pcall(showSpearLine, trailOrigin, trailDir, trailSpeed) end
        return old(self, unpack(args, 1, args.n))
    end

