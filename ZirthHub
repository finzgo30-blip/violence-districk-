                TweenService:Create(stroke, TweenInfo.new(0.14), {
                    Color = origColor, Transparency = origTrans, Thickness = origThick
                }):Play()
                task.wait(0.18)
            end
            if stroke.Parent then
                stroke.Color = origColor
                stroke.Transparency = origTrans
                stroke.Thickness = origThick
            end
        end)
