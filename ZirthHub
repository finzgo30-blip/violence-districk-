	local rotationHookInstalled = false
	local function installRotationHook()
		if rotationHookInstalled then return end
		pcall(function()
			if hookmetamethod then
				local origIndex
				origIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
					if key == "Rotation" and not (checkcaller and checkcaller()) then
						if ActiveLine and self == ActiveLine and ActiveTargetRot then
