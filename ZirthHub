    local function descApply(id, humanoid, override)
        local desc = override
        if not desc then
            for _ = 1, 3 do
                local ok, d = pcall(function() return Players:GetHumanoidDescriptionFromUserId(id) end)
                if ok and d then desc = d break end
                task.wait(0.4)
            end
            if not desc then return false end
        end
        local core = false
        for attempt = 1, 4 do
            if not humanoid.Parent then return false end
            local applied = pcall(function() humanoid:ApplyDescriptionReset(desc) end)
            if not applied then applied = pcall(function() humanoid:ApplyDescription(desc) end) end
            if not applied then
                task.wait(0.3)
            else
                task.wait(0.35 + 0.15 * attempt)
                local okA, cur = pcall(function() return humanoid:GetAppliedDescription() end)
                if okA and cur then
                    core = cur.Shirt == desc.Shirt and cur.Pants == desc.Pants and cur.Face == desc.Face
                    local bodyOk = true
                    for _, f in ipairs(BODY_FIELDS) do
                        if cur[f] ~= desc[f] then bodyOk = false break end
                    end
                    if core and bodyOk then return true end
                end
            end
        end
        return core
    end

